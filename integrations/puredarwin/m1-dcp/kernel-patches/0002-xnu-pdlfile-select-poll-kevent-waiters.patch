 static const struct pd_lfile_ops *pd_lfile_ops;
 static const struct fileops pd_lfileops;
 
+// One wait channel for every linux file. The object is the linuxkpi side's and has no room
+// for a selinfo, so a wakeup for any of them makes each waiter ask its own object again
+// (select scans again, a knote runs its process routine). The lock is the selinfo's
+// "primitive lock" (bsd/kern/sys_generic.c): selrecord and selwakeup run under it, and it
+// is never held across a call into the object's ops.
+static LCK_GRP_DECLARE(pd_lfile_lck_grp, "pd_lfile");
+static LCK_MTX_DECLARE(pd_lfile_sel_lock, &pd_lfile_lck_grp);
+static struct selinfo pd_lfile_sel;
+
 // a descriptor still reserved by pd_lfile_reserve, with the proc fd lock held
 static struct fileproc *
 pd_lfile_reserved_locked(proc_t p, int fd)
@@ -84,12 +102,117 @@
 }
 
 static int
-pd_lfile_select(struct fileproc *fp, int which, __unused void *wql, __unused vfs_context_t ctx)
+pd_lfile_select(struct fileproc *fp, int which, void *wql, vfs_context_t ctx)
 {
-	if (pd_lfile_ops->poll == NULL) {
+	void *obj = fp_get_data(fp);
+
+	if (obj == NULL || pd_lfile_ops->poll == NULL) {
 		return 1;
 	}
-	return pd_lfile_ops->poll(fp_get_data(fp), which);
+	// recorded before the object is asked: a wakeup between the two is then not lost
+	lck_mtx_lock(&pd_lfile_sel_lock);
+	selrecord(vfs_context_proc(ctx), &pd_lfile_sel, wql);
+	lck_mtx_unlock(&pd_lfile_sel_lock);
+	return pd_lfile_ops->poll(obj, which);
+}
+
+// the state of obj changed (a fence signalled): select and kevent waiters look again
+void
+pd_lfile_wakeup(__unused void *obj)
+{
+	lck_mtx_lock(&pd_lfile_sel_lock);
+	selwakeup(&pd_lfile_sel);
+	lck_mtx_unlock(&pd_lfile_sel_lock);
+}
+
+// kevent on a linux file, the way spec_filtops (bsd/miscfs/specfs/spec_vnops.c) does it for
+// devices that only have select: run the select routine with the hook that hands the
+// selinfo to selspec_attach(). selwakeup() then activates and detaches the knote, and its
+// process routine asks the object and attaches again while it is not ready.
+static int
+pd_lfile_filt_common(struct knote *kn, struct kevent_qos_s *kev)
+{
+	uthread_t uth = current_uthread();
+	struct select_set *old_wqs;
+	int ready;
+
+	if (kn->kn_flags & EV_EOF) {
+		knote_fill_kevent(kn, kev, 0);
+		return FILTER_ACTIVE;
+	}
+
+	selspec_record_hook_t cb = ^(struct selinfo *si) {
+		selspec_attach(kn, si);
+	};
+
+	old_wqs = uth->uu_selset;
+	uth->uu_selset = SELSPEC_RECORD_MARKER;
+	ready = pd_lfile_select(kn->kn_fp, knote_get_seltype(kn), cb, vfs_context_current());
+	uth->uu_selset = old_wqs;
+
+	if (ready) {
+		knote_fill_kevent(kn, kev, 1);
+		return FILTER_ACTIVE;
+	}
+	return 0;
+}
+
+static int
+pd_lfile_filt_attach(struct knote *kn, struct kevent_qos_s *kev)
+{
+	return pd_lfile_filt_common(kn, kev);
+}
+
+static void
+pd_lfile_filt_detach(struct knote *kn)
+{
+	selspec_detach(kn);
+}
+
+static int
+pd_lfile_filt_event(struct knote *kn, long hint)
+{
+	// called by selwakeup() with the selspec lock held; it has taken the knote off the list
+	assert(KNOTE_IS_AUTODETACHED(kn));
+	knote_kn_hook_set_raw(kn, NULL);
+	if (hint & NOTE_REVOKE) {
+		os_atomic_or(&kn->kn_flags, EV_EOF | EV_ONESHOT, relaxed);
+	}
+	return FILTER_ACTIVE;
+}
+
+static int
+pd_lfile_filt_touch(struct knote *kn, struct kevent_qos_s *kev)
+{
+	kn->kn_sdata = kev->data;
+	kn->kn_sfflags = kev->fflags;
+	return pd_lfile_filt_common(kn, kev);
+}
+
+static int
+pd_lfile_filt_process(struct knote *kn, struct kevent_qos_s *kev)
+{
+	return pd_lfile_filt_common(kn, kev);
+}
+
+SECURITY_READ_ONLY_EARLY(struct filterops) pd_lfile_filtops = {
+	.f_isfd    = 1,
+	.f_attach  = pd_lfile_filt_attach,
+	.f_detach  = pd_lfile_filt_detach,
+	.f_event   = pd_lfile_filt_event,
+	.f_touch   = pd_lfile_filt_touch,
+	.f_process = pd_lfile_filt_process,
+};
+
+static int
+pd_lfile_kqfilter(__unused struct fileproc *fp, struct knote *kn, struct kevent_qos_s *kev)
+{
+	if (kn->kn_filter != EVFILT_READ && kn->kn_filter != EVFILT_WRITE) {
+		knote_set_error(kn, EINVAL);
+		return 0;
+	}
+	kn->kn_filtid = EVFILTID_PDLFILE;
+	return pd_lfile_filt_attach(kn, kev);
 }
 
 static int
