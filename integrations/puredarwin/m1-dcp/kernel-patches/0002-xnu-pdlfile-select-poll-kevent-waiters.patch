 	.fo_select   = pd_lfile_select,
 	.fo_close    = pd_lfile_close,
 	.fo_drain    = fo_no_drain,
-	.fo_kqfilter = fo_no_kqfilter,
+	.fo_kqfilter = pd_lfile_kqfilter,
 };
 
