#!/bin/sh
# Guest side of the on-screen GPU demo: three GLES scenes rendered off-screen on the GPU at panel
# resolution and shown on the built-in panel through the PDGOP framebuffer mapping, timed in
# three modes each (render, +readback, +present). The demo saves the console image first and
# puts it back before it prints, so every AGX* line reaches this console.
# Stage the bundle of agx-offscreen-test.nix (see the README for the PCIE_EXTRA_FILES list).
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL42_PANEL_BEGIN_%s\n' "$nonce"
start=$(date +%s)
if ls /dev/dri/renderD* >/dev/null 2>&1; then
    # 40 s of measurements at most; each present run stays on the panel 250 ms before the
    # console comes back. No pipe: the exit status below is the demo's own.
    agx-panel-demo --require-renderer "Apple M1" --frames 30 --budget 40 --hold-ms 250 2>&1
    printf 'DL42_PANEL_RC=%s seconds=%s\n' "$?" "$(( $(date +%s) - start ))"
else
    printf 'DL42_PANEL_SKIPPED no render node\n'
fi
printf 'DL42_PANEL_END_%s\n' "$nonce"
