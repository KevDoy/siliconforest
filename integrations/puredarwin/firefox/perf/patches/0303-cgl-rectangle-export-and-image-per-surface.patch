+// (FXPERF2) SFFX_GPU_IMAGE_CACHE=1: an IOSurface's EGLImage is kept per surface, not per texture. A layer's texture
+// re-pointed at a surface imported before (Firefox's tiles and the window's frames alternate between a few surfaces)
+// only re-targets that image instead of importing the dma-buf again. Each entry retains its surface, so its storage
+// cannot go and come back as another surface; an entry no texture uses is let go once nothing else holds the
+// surface, or when the cache is full. Called with pd_cgl_track_lock held.
+#define PD_CGL_IMAGES 96
+static struct pd_cgl_image {
+    IOSurfaceRef surface;size_t offset,row;GLsizei width,height;EGLint fourcc;EGLImage image;int users;uint64_t used;
+} pd_cgl_images[PD_CGL_IMAGES];
+static int pd_cgl_image_count;
+static uint64_t pd_cgl_image_clock,pd_cgl_image_stats[3]; // hits, imports, let go
+static int pd_cgl_image_cache_on(void){
+    static int on=-1;
+    if(on<0){const char *v=getenv("SFFX_GPU_IMAGE_CACHE");on=v&&!strcmp(v,"1");}
+    return on;
+}
+void CGLSFFXImageCacheStats(uint64_t values[3]){if(values)memcpy(values,pd_cgl_image_stats,sizeof(pd_cgl_image_stats));}
+static void pd_cgl_image_forget(int i){
+    if(pd_present.destroyImage)pd_present.destroyImage(pd_cgl_get_display(),pd_cgl_images[i].image);
+    if(pd_cf_release)pd_cf_release(pd_cgl_images[i].surface);
+    pd_cgl_images[i]=pd_cgl_images[--pd_cgl_image_count];
+    pd_cgl_image_stats[2]++;
+}
+static void pd_cgl_image_sweep(void){
+    static long (*retainCount)(const void *);
+    static int looked;
+    if(!looked){retainCount=(long (*)(const void *))dlsym(RTLD_DEFAULT,"CFGetRetainCount");looked=1;}
+    for(int i=0;i<pd_cgl_image_count;)
+        if(pd_cgl_images[i].users<=0&&retainCount&&retainCount(pd_cgl_images[i].surface)<=1)pd_cgl_image_forget(i);
+        else i++;
+}
+static EGLImage pd_cgl_image_find(IOSurfaceRef surface,size_t offset,size_t row,GLsizei w,GLsizei h,EGLint fourcc){
+    // surfaces the application let go of are released now and then, not only when a new one is imported
+    if((pd_cgl_image_clock&127)==127)pd_cgl_image_sweep();
+    for(int i=0;i<pd_cgl_image_count;i++){
+        struct pd_cgl_image *e=&pd_cgl_images[i];
+        if(e->surface==surface&&e->offset==offset&&e->row==row&&e->width==w&&e->height==h&&e->fourcc==fourcc){
+            e->users++;e->used=++pd_cgl_image_clock;pd_cgl_image_stats[0]++;return e->image;
+        }
+    }
+    return EGL_NO_IMAGE_KHR;
+}
+static void pd_cgl_image_keep(IOSurfaceRef surface,size_t offset,size_t row,GLsizei w,GLsizei h,EGLint fourcc,EGLImage image){
+    pd_cgl_image_stats[1]++;
+    if(!pd_cf_retain)return;
+    pd_cgl_image_sweep();
+    if(pd_cgl_image_count==PD_CGL_IMAGES){
+        int oldest=-1;
+        for(int i=0;i<pd_cgl_image_count;i++)
+            if(pd_cgl_images[i].users<=0&&(oldest<0||pd_cgl_images[i].used<pd_cgl_images[oldest].used))oldest=i;
+        if(oldest<0)return; // all in use: this image stays the texture's own
+        pd_cgl_image_forget(oldest);
+    }
+    pd_cgl_images[pd_cgl_image_count++]=(struct pd_cgl_image){(IOSurfaceRef)pd_cf_retain(surface),offset,row,w,h,fourcc,image,1,++pd_cgl_image_clock};
+}
+// a texture no longer uses its image: 1 when the cache owns it (it stays), 0 when the caller destroys it
+static int pd_cgl_image_release(EGLImage image){
+    for(int i=0;i<pd_cgl_image_count;i++)
+        if(pd_cgl_images[i].image==image){pd_cgl_images[i].users--;return 1;}
+    return 0;
+}
