+/* Callers (C, and Rust bindings built against the original header) rely on
+ * this exact 64-byte layout. The queries below must not grow it. */
+_Static_assert(sizeof(PDGOPFramebuffer) == 64, "PDGOPFramebuffer ABI size");
+_Static_assert(_Alignof(PDGOPFramebuffer) == 8, "PDGOPFramebuffer ABI alignment");
