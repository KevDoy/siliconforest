+/* Virtio needs a present call per update; every other match is an
+ * IOFramebuffer whose mapped VRAM is the scanout buffer. */
+static uint32_t
+pdgop_service_kind(mach_port_t service)
+{
+    boolean_t virtio = 0;
+#ifdef _PD_IOKITLIB_H
+    if (IOObjectConformsTo(service, "IOVirtIOGPU", &virtio) != KERN_SUCCESS)
+        return kPDGOPServiceUnknown;
+#else
+    virtio = IOObjectConformsTo(service, "IOVirtIOGPU");
+#endif
+    return virtio ? kPDGOPServiceVirtioTransfer : kPDGOPServiceDirectMemory;
+}
+
+static int
+pdgop_geometry_valid(const IOPixelInformation *pi)
+{
+    if (pi->activeWidth == 0 || pi->activeHeight == 0)
+        return 0;
+    if (pi->bitsPerPixel == 0 || pi->bitsPerPixel > 32 || (pi->bitsPerPixel % 8) != 0)
+        return 0;
+    if ((uint64_t)pi->bytesPerRow < (uint64_t)pi->activeWidth * (pi->bitsPerPixel / 8))
+        return 0;
+    return 1;
+}
