+++ b/src/Libraries/PDGOP/include/PDGOP.h
@@ -24,11 +24,38 @@ typedef struct PDGOPFramebuffer {
     uint32_t componentMasks[3];
 } PDGOPFramebuffer;
 
+/* How pixels written to the mapped VRAM reach the display. */
+typedef enum PDGOPServiceKind {
+    kPDGOPServiceUnknown = 0,
+    /* IOGOPFramebuffer / IOFramebuffer: the mapped VRAM is the scanout
+     * buffer. There is no transfer step; PDGOPPresent does not apply. */
+    kPDGOPServiceDirectMemory = 1,
+    /* IOVirtIOGPU: VRAM is guest memory; PDGOPPresent transfers a rect. */
+    kPDGOPServiceVirtioTransfer = 2,
+} PDGOPServiceKind;
+
+/* Layout of one 32-bit native pixel word, from bpp and componentMasks. */
+typedef enum PDGOPPixelFormat {
+    kPDGOPFormatUnknown = 0,
+    kPDGOPFormatXRGB8888 = 1,      /* x8 r8 g8 b8 */
+    kPDGOPFormatXRGB2101010 = 2,   /* x2 r10 g10 b10 */
+} PDGOPPixelFormat;
+
+/* Returns KERN_SUCCESS only with a validated, mapped framebuffer: every
+ * driver reply is complete, the geometry is self-consistent and the mapping
+ * covers stride * height bytes. On failure fb is zeroed and
+ * PDGOPLastErrorStage() names the step. */
 kern_return_t PDGOPOpen(PDGOPFramebuffer *fb);
 void PDGOPClose(PDGOPFramebuffer *fb);
+/* Transfers a rect to the display for kPDGOPServiceVirtioTransfer only.
+ * Any other service returns KERN_NOT_SUPPORTED without a driver call:
+ * a direct-memory framebuffer has no present step. */
 kern_return_t PDGOPPresent(PDGOPFramebuffer *fb,
                            uint32_t x, uint32_t y,
                            uint32_t width, uint32_t height);
+/* Queries derived from the fields above; the struct layout is unchanged. */
+PDGOPServiceKind PDGOPGetServiceKind(const PDGOPFramebuffer *fb);
+PDGOPPixelFormat PDGOPGetPixelFormat(const PDGOPFramebuffer *fb);
 const char *PDGOPLastErrorStage(void);
 
