+_Static_assert(__builtin_offsetof(PDGOPFramebuffer, size) == 24, "PDGOPFramebuffer ABI");
+_Static_assert(__builtin_offsetof(PDGOPFramebuffer, width) == 32, "PDGOPFramebuffer ABI");
+_Static_assert(__builtin_offsetof(PDGOPFramebuffer, bpp) == 44, "PDGOPFramebuffer ABI");
+_Static_assert(__builtin_offsetof(PDGOPFramebuffer, componentMasks) == 52, "PDGOPFramebuffer ABI");
+
