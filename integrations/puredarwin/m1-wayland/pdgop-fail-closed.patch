@@ -189,6 +266,39 @@ PDGOPPresent(PDGOPFramebuffer *fb, uint32_t x, uint32_t y,
                                       &rect, sizeof(rect), NULL, NULL);
 }
 
+PDGOPPixelFormat
+PDGOPGetPixelFormat(const PDGOPFramebuffer *fb)
+{
+    if (fb == NULL || fb->bpp != 32)
+        return kPDGOPFormatUnknown;
+    if (fb->componentMasks[0] == 0x00ff0000 &&
+        fb->componentMasks[1] == 0x0000ff00 &&
+        fb->componentMasks[2] == 0x000000ff)
+        return kPDGOPFormatXRGB8888;
+    if (fb->componentMasks[0] == 0x3ff00000 &&
+        fb->componentMasks[1] == 0x000ffc00 &&
+        fb->componentMasks[2] == 0x000003ff)
+        return kPDGOPFormatXRGB2101010;
+    return kPDGOPFormatUnknown;
+}
+
+PDGOPServiceKind
+PDGOPGetServiceKind(const PDGOPFramebuffer *fb)
+{
+    uint32_t kind;
+
+    if (fb == NULL || fb->service == IO_OBJECT_NULL)
+        return kPDGOPServiceUnknown;
+    if (fb->service == gPDGOPKindService)
+        return (PDGOPServiceKind)gPDGOPKind;
+    kind = pdgop_service_kind(fb->service);
+    if (kind != kPDGOPServiceUnknown) {
+        gPDGOPKindService = fb->service;
+        gPDGOPKind = kind;
+    }
+    return (PDGOPServiceKind)kind;
+}
