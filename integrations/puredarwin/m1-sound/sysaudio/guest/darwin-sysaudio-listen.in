#!/bin/sh
# SPDX-License-Identifier: MIT
# Listening script for the system audio path: needs a person at the M1 with headphones in the
# jack BEFORE the boot. Run:
#   SD_RUNTIME=240 tools/sa_boot.sh sd<NN> guest/darwin-sysaudio-listen.in
# Everything goes through AudioToolbox and coreaudiod to /dev/pdaudio. The level starts at
# pdvolume 50 (31 dB codec attenuation), tones are @TONEDB@ dB below full scale: clearly
# audible, not loud. About 30 s after the boot's picture the steps follow one another with a
# two second pause between them; the console names each step (SA_LISTEN) as it starts.
# What must be heard:
#   1. A 440 Hz tone for 3 s in both ears. It starts about a second after the step begins
#      (the codec's start) but must start cleanly and last the full 3 s: no click, no
#      clipped start or end, a steady pitch without crackle or warble.
#   2. The same tone for 2 s in the LEFT ear only, then 2 s in the RIGHT ear only.
#   3. Two tones at once for 5 s: 440 Hz left and 660 Hz right (two clients, one at 44.1 kHz
#      and one at 48 kHz, mixed). Both steady and clean; the left one must not sound rougher
#      than in step 2 (it is rate converted).
#   4. A 14 s tone that gets quieter in four steps, one a second, then louder again in four
#      steps (pdvolume down/up), then is silent for 2 s (mute) and comes back (unmute) at the
#      level it had. No click or dropout at a step.
#   5. Two 1 s tones (660 Hz) a second apart: the second starts at once, without the
#      one second wait of step 1 (the device stays open between clients).
#   6. After 8 s of silence a 1 s tone at 880 Hz: after the driver has stopped and started
#      again it must still be complete and about 1 s long.
#   7. A 1 kHz tone for 2 s (the tree's pcmplay; 10 dB quieter than the others): clean, both
#      ears. Its last tenth of a second or so may be missing (pcmplay stops at its last buffer).
# Report for each step: heard as described or what was wrong (click, crackle, wrong ear,
# wrong pitch, too short, too loud).
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
@COMMON@
printf '\nSA_BEGIN_%s\n' "$nonce"
bringup
start_server
step() { sleep 2; printf 'SA_LISTEN step %s: %s (jack=%s)\n' "$1" "$2" "$(get kern.pd_sound.jack)"; }
bounded 10 pdvolume unmute
bounded 10 pdvolume set 50

step 1 "440 Hz, both ears, 3 s"
bounded 20 pdtone -r 48000 -f 440 -s 3 -d @TONEDB@ -n both
step 2 "440 Hz, left 2 s then right 2 s"
bounded 20 pdtone -r 48000 -f 440 -s 2 -d @TONEDB@ -c l -n left
bounded 20 pdtone -r 48000 -f 440 -s 2 -d @TONEDB@ -c r -n right
step 3 "440 Hz left (44.1 kHz client) and 660 Hz right (48 kHz client) together, 5 s"
pdtone -r 44100 -f 440 -s 5 -d @TONEDB@ -c l -n mix44 2>&1 &
a=$!
pdtone -r 48000 -f 660 -s 5 -d @TONEDB@ -c r -n mix48 2>&1 &
b=$!
wait_pids 25 "$a" "$b"
step 4 "440 Hz for 14 s: four steps down, four up, 2 s mute, back"
pdtone -r 48000 -f 440 -s 14 -d @TONEDB@ -n volume 2>&1 &
a=$!
sleep 2
for c in down down down down up up up up; do pdvolume $c 2>&1; sleep 1; done
pdvolume mute 2>&1; sleep 2; pdvolume unmute 2>&1
wait_pids 25 "$a"
step 5 "660 Hz, two 1 s tones a second apart"
bounded 20 pdtone -r 48000 -f 660 -s 1 -d @TONEDB@ -n first
sleep 1
bounded 20 pdtone -r 48000 -f 660 -s 1 -d @TONEDB@ -n second
step 6 "8 s of silence, then 880 Hz for 1 s"
idle 15 before-restart
sleep 2
bounded 20 pdtone -r 48000 -f 880 -s 1 -d @TONEDB@ -n restart
step 7 "1 kHz for 2 s through pcmplay"
bounded 20 pcmplay /usr/share/sysaudio-test.pcm
idle 15 end
showlog
mon end
sysctl -w kern.pd_sound.volume_db=@VOLUME@ 2>&1
kill "$server" 2>/dev/null
printf 'SA_END_%s\n' "$nonce"
printf '\nPD_BENCH_DONE\n'
