+
+// a sound driver that is a character device: 16-bit little-endian stereo frames written to path play at the
+// driver's rate. Its sysctls below the prefix, each used when it is there: rate; volume_db, the codec's
+// attenuation in dB with 63 its mute; frames, the frames played since boot; playing, sessions, lock_ms and
+// preroll_ms, which tell when a session has passed its silent start, during which the driver keeps what was
+// written; jack, above zero while something is plugged
+enum { kDevJackPlugged = 1, kDevJackEmpty };
+
+struct dev_desc {
+    const char *name;
+    const char *uid;
+    const char *path;
+    // names another node in the environment, so a stand-in can take the place of a device that is not there
+    const char *pathEnv;
+    const char *sysctl;
+    // volume_db sets the level, else the mix is scaled
+    bool hardwareVolume;
+    // which state of the jack makes this the default output
+    int route;
+};
+
+static const struct dev_desc sDevTable[] = {
+    { "Headphones", "PDAudio:headphones", "/dev/pdaudio", NULL, "kern.pd_sound", true, kDevJackPlugged },
+    { "Speakers", "PDAudio:speakers", "/dev/pdspeaker", "COREAUDIOD_SPEAKER_DEVICE", "kern.pd_speaker", false, kDevJackEmpty },
+};
+
+#define DEV_RATE 48000
+// frames kept queued in the driver ahead of its playback
+#define DEV_QUEUE_FRAMES 3072
+// what the driver holds between its queue and the converter: PDAppleSound fills five DMA periods of 1024 ahead
+#define DEV_OUTPUT_FRAMES 5120
+// the node stays open this long after the last client stopped, a start of the driver costs a second of silence
+#define DEV_LINGER_SECONDS 5
+#define DEV_STATS_SECONDS 5
+#define DEV_MUTE_DB 63
+#define DEV_RANGE_DB 62
+// the level of a device without a hardware volume until someone sets one
+#define DEV_SOFT_VOLUME 0.5f
+
+// one open of the node
+struct dev_run {
+    int fd;
+    // the driver counts the frames it played, so the writes follow its clock; else they follow the host's
+    bool counted;
+    int framesMib[CTL_MAXNAME];
+    size_t framesMibLen;
+    // the driver takes frames from its queue: the session runs and its silent start is over
+    bool started;
+    bool wasPlaying;
+    int sessions;
+    bool failed;
+    uint64_t opened, advanced, nextTime;
+    uint32_t lastFrames;
+    // frames written since the open, and taken by the driver since it started
+    uint64_t written, taken;
+    // a period went out in the last turn, so an empty queue now is an underrun
+    bool fed;
+    uint64_t periods;
+    uint32_t byClients[4];
+    uint32_t clients, mostClients;
+    uint32_t underruns;
+    uint64_t lostFrames;
+};
+
+static bool devGet(const struct dev_desc *d, const char *leaf, int *out)
+{
+    char name[96];
+    size_t size = sizeof(*out);
+
+    snprintf(name, sizeof(name), "%s.%s", d->sysctl, leaf);
+    return sysctlbyname(name, out, &size, NULL, 0) == 0 && size == sizeof(*out);
+}
+
+static bool devSet(const struct dev_desc *d, const char *leaf, int value)
+{
+    char name[96];
+
+    snprintf(name, sizeof(name), "%s.%s", d->sysctl, leaf);
+    return sysctlbyname(name, NULL, NULL, &value, sizeof(value)) == 0;
+}
+
+static const char *devPath(const struct dev_desc *d)
+{
+    const char *p = d->pathEnv ? getenv(d->pathEnv) : NULL;
+
+    return p && p[0] ? p : d->path;
+}
+
+static uint64_t devTicks(const struct engine *e, uint32_t ms)
+{
+    return (uint64_t)(e->ticksPerFrame * e->rate * ms / 1000.0);
+}
+
+// the level as the driver takes it, in dB below the codec's full scale: none at 1.0, 62 at 0.0, the mute apart
+static void devApplyVolume(struct engine *e)
+{
+    int db = e->info.mute ? DEV_MUTE_DB : (int)((1.0f - e->info.volume) * DEV_RANGE_DB + 0.5f);
+
+    if (!e->dev->hardwareVolume)
+        return;
+    if (devSet(e->dev, "volume_db", db))
+        fprintf(stderr, "coreaudiod: %s volume %.3f%s: %s.volume_db=%d\n", e->info.name, e->info.volume,
+                e->info.mute ? ", muted" : "", e->dev->sysctl, db);
+    else
+        fprintf(stderr, "coreaudiod: setting %s.volume_db=%d failed: %s\n", e->dev->sysctl, db, strerror(errno));
+}
+
+static uint32_t devPlayingClients(struct engine *e)
+{
+    uint32_t n = 0;
+
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        if (sClients[i].ring && sClients[i].ring->running && clientEngine(&sClients[i]) == e)
+            n++;
+    }
+    return n;
+}
+
+static void devSetRunning(struct engine *e, bool run)
+{
+    pthread_mutex_lock(&sLock);
+    if (run)
+        e->info.flags |= kPDAudioDeviceRunning;
+    else
+        e->info.flags &= ~kPDAudioDeviceRunning;
+    broadcastLocked(kPDAudioChangedRunning);
+    pthread_mutex_unlock(&sLock);
+}
+
+static bool devOpen(struct engine *e, struct dev_run *r)
+{
+    const struct dev_desc *d = e->dev;
+    char name[96];
+    int v;
+
+    memset(r, 0, sizeof(*r));
+    // the driver changes its rate only between sessions, and someone may have set another since
+    if (devGet(d, "rate", &v) && v != (int)e->rate && (!devSet(d, "rate", (int)e->rate)))
+        fprintf(stderr, "coreaudiod: %s runs at %d Hz and cannot be set to %u now\n", e->info.name, v, e->rate);
+    if ((r->fd = open(devPath(d), O_WRONLY)) < 0) {
+        fprintf(stderr, "coreaudiod: opening %s failed: %s\n", devPath(d), strerror(errno));
+        return false;
+    }
+    snprintf(name, sizeof(name), "%s.frames", d->sysctl);
+    r->framesMibLen = CTL_MAXNAME;
+    r->counted = sysctlnametomib(name, r->framesMib, &r->framesMibLen) == 0;
+    // read after the open: a session that still runs now does not end under this writer
+    r->wasPlaying = devGet(d, "playing", &v) && v == 1;
+    if (!devGet(d, "sessions", &r->sessions))
+        r->sessions = -1;
+    r->opened = r->advanced = mach_absolute_time();
+    devSetRunning(e, true);
+    fprintf(stderr, "coreaudiod: %s: opened %s at %u Hz, %s\n", e->info.name, devPath(d), e->rate,
+            r->counted ? "paced by the driver's frame count" : "paced by the host clock");
+    return true;
+}
+
+static void devStats(struct engine *e, struct dev_run *r, const char *when)
+{
+    fprintf(stderr, "coreaudiod: %s: %s after %.1f s: %llu periods (%llu frames) written; periods by clients mixed "
+            "0:%u 1:%u 2:%u 3+:%u, most at once %u; %u underruns (%llu frames)\n", e->info.name, when,
+            (mach_absolute_time() - r->opened) / (e->ticksPerFrame * e->rate), (unsigned long long)r->periods,
+            (unsigned long long)r->periods * PERIOD_FRAMES, r->byClients[0], r->byClients[1], r->byClients[2],
+            r->byClients[3], r->mostClients, r->underruns, (unsigned long long)r->lostFrames);
+}
+
+static void devClose(struct engine *e, struct dev_run *r)
+{
+    close(r->fd);
+    devSetRunning(e, false);
+    devStats(e, r, "closed");
+}
+
+static uint32_t devFrames(struct dev_run *r)
+{
+    int v = 0;
+    size_t size = sizeof(v);
+
+    sysctl(r->framesMib, (u_int)r->framesMibLen, &v, &size, NULL, 0);
+    return (uint32_t)v;
+}
+
+// frames written that the driver has not taken yet. Its count moves on while its queue is empty, so a queue
+// found below nothing starts from nothing again: what was missed is not made up for
+static int64_t devQueued(struct engine *e, struct dev_run *r, uint64_t now)
+{
+    if (!r->counted || !r->started)
+        return (int64_t)r->written;
+
+    uint32_t frames = devFrames(r);
+    if (frames != r->lastFrames)
+        r->advanced = now;
+    r->taken += (uint32_t)(frames - r->lastFrames);
+    r->lastFrames = frames;
+    if (r->taken > r->written) {
+        if (r->fed) {
+            r->underruns++;
+            r->lostFrames += r->taken - r->written;
+            if (r->underruns <= 8)
+                fprintf(stderr, "coreaudiod: %s late by %llu frames, skipping ahead\n", e->info.name,
+                        (unsigned long long)(r->taken - r->written));
+        }
+        r->written = r->taken;
+    }
+    return (int64_t)(r->written - r->taken);
+}
+
+// 1 once the driver takes frames from its queue, 0 while its session starts, -1 when it did not start one
+static int devStarted(struct engine *e, struct dev_run *r, uint64_t now)
+{
+    const struct dev_desc *d = e->dev;
+    int playing = 0, sessions = -1, lock = 0, preroll = 1500;
+
+    if (!devGet(d, "playing", &playing))
+        return 1;
+    if (playing == 1) {
+        // lock_ms is the last session's until the one these frames started is counted
+        bool mine = r->wasPlaying || !devGet(d, "sessions", &sessions) || sessions != r->sessions;
+        if (mine && (!devGet(d, "lock_ms", &lock) || lock >= 0))
+            return 1;
+    }
+    devGet(d, "preroll_ms", &preroll);
+    if (now - r->opened < devTicks(e, (uint32_t)preroll + 1000))
+        return 0;
+    // without a lock the driver plays on once its wait is over
+    return playing == 1 ? 1 : -1;
+}
+
+static bool devWrite(int fd, const void *data, size_t size)
+{
+    const uint8_t *p = data;
+
+    while (size > 0) {
+        ssize_t n = write(fd, p, size);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            return false;
+        p += n;
+        size -= (size_t)n;
+    }
+    return true;
+}
+
+// mixes and writes periods while a client plays and for a while after the last one, then returns
+static void devRun(struct engine *e, struct dev_run *r)
+{
+    int16_t out[PERIOD_FRAMES * 2];
+    uint64_t idleSince = r->opened, statsAt = r->opened + devTicks(e, DEV_STATS_SECONDS * 1000);
+
+    for (;;) {
+        uint64_t now = mach_absolute_time();
+        int64_t queued = devQueued(e, r, now);
+
+        pthread_mutex_lock(&sLock);
+        bool playing = anyPlaying(e);
+        pthread_mutex_unlock(&sLock);
+        if (!playing) {
+            // the driver plays silence by itself while its queue is empty
+            if (r->fed)
+                idleSince = now;
+            r->fed = false;
+            r->nextTime = 0;
+            if (now - idleSince > devTicks(e, DEV_LINGER_SECONDS * 1000))
+                return;
+            usleep(10000);
+            continue;
+        }
+
+        if (r->counted) {
+            if (!r->started && (r->wasPlaying || r->written >= DEV_QUEUE_FRAMES)) {
+                int s = devStarted(e, r, now);
+                if (s < 0) {
+                    fprintf(stderr, "coreaudiod: %s did not start playing\n", e->info.name);
+                    r->failed = true;
+                    return;
+                }
+                if (s > 0) {
+                    r->started = true;
+                    r->lastFrames = devFrames(r);
+                    r->advanced = now;
+                    fprintf(stderr, "coreaudiod: %s: the driver plays %u ms after the open\n", e->info.name,
+                            (uint32_t)((now - r->opened) / devTicks(e, 1)));
+                } else if (r->written >= DEV_QUEUE_FRAMES) {
+                    usleep(3000);
+                    continue;
+                }
+            }
+            if (r->started && queued + PERIOD_FRAMES > DEV_QUEUE_FRAMES) {
+                if (now - r->advanced > devTicks(e, 2000)) {
+                    fprintf(stderr, "coreaudiod: %s stopped taking frames\n", e->info.name);
+                    r->failed = true;
+                    return;
+                }
+                usleep(2000);
+                continue;
+            }
+        } else {
+            if (r->nextTime == 0 || now > r->nextTime + devTicks(e, 100))
+                r->nextTime = now;
+            if (now < r->nextTime)
+                mach_wait_until(r->nextTime);
+            r->nextTime += (uint64_t)(e->ticksPerFrame * PERIOD_FRAMES);
+            queued = 0;
+        }
+
+        pthread_mutex_lock(&sLock);
+        uint32_t clients = devPlayingClients(e);
+        e->devHostTime = mach_absolute_time() + (uint64_t)((queued + PERIOD_FRAMES + DEV_OUTPUT_FRAMES) * e->ticksPerFrame);
+        mixClients(e, 0);
+        pthread_mutex_unlock(&sLock);
+
+        const float *mix = e->mix->fData;
+        for (uint32_t i = 0; i < PERIOD_FRAMES * 2; i++) {
+            float x = mix[i] * 32767.0f;
+            x = x > 32767.0f ? 32767.0f : x < -32767.0f ? -32767.0f : x;
+            out[i] = (int16_t)(x < 0 ? x - 0.5f : x + 0.5f);
+        }
+        if (!devWrite(r->fd, out, sizeof(out))) {
+            fprintf(stderr, "coreaudiod: writing to %s failed: %s\n", devPath(e->dev), strerror(errno));
+            r->failed = true;
+            return;
+        }
+        r->written += PERIOD_FRAMES;
+        r->fed = true;
+        r->periods++;
+        r->byClients[clients < 3 ? clients : 3]++;
+        if (clients > r->mostClients)
+            r->mostClients = clients;
+        if (clients != r->clients) {
+            fprintf(stderr, "coreaudiod: %s: mixing %u client%s\n", e->info.name, clients, clients == 1 ? "" : "s");
+            r->clients = clients;
+        }
+        if (now >= statsAt) {
+            devStats(e, r, "open");
+            statsAt = now + devTicks(e, DEV_STATS_SECONDS * 1000);
+        }
+    }
+}
+
+// the node is open from the first client that plays until some seconds after the last
+static void *devThread(void *arg)
+{
+    struct engine *e = arg;
+    struct dev_run r;
+
+    for (;;) {
+        pthread_mutex_lock(&sLock);
+        bool playing = anyPlaying(e);
+        pthread_mutex_unlock(&sLock);
+        if (!playing) {
+            usleep(10000);
+            continue;
+        }
+        if (!devOpen(e, &r)) {
+            sleep(1);
+            continue;
+        }
+        devRun(e, &r);
+        devClose(e, &r);
+        if (r.failed)
+            sleep(1);
+    }
+    return NULL;
+}
+
+// an engine for every node of the table that is there, on a machine without an IOAudioEngine
+static bool devScanLocked(void)
+{
+    bool added = false;
+
+    for (int j = 0; j < kPDAudioMaxDevices; j++) {
+        if (sEngines[j].used && !sEngines[j].dev)
+            return false;
+    }
+    for (size_t i = 0; i < sizeof(sDevTable) / sizeof(sDevTable[0]); i++) {
+        const struct dev_desc *d = &sDevTable[i];
+        struct engine *e = NULL;
+        struct stat st;
+        bool have = false;
+        int v;
+
+        for (int j = 0; j < kPDAudioMaxDevices; j++) {
+            if (sEngines[j].used && sEngines[j].dev == d)
+                have = true;
+            if (!sEngines[j].used && !e)
+                e = &sEngines[j];
+        }
+        if (have || !e || stat(devPath(d), &st) != 0 || !S_ISCHR(st.st_mode))
+            continue;
+
+        memset(e, 0, sizeof(*e));
+        e->mixSize = sizeof(buffer_descriptor) + (size_t)PERIOD_FRAMES * 2 * sizeof(float);
+        if (!(e->mix = calloc(1, e->mixSize)))
+            continue;
+        e->dev = d;
+        e->channels = 2;
+        // the device runs at one rate, clients at another are converted
+        e->rate = DEV_RATE;
+        if (devGet(d, "rate", &v) && v != DEV_RATE && !devSet(d, "rate", DEV_RATE) && v > 0)
+            e->rate = (uint32_t)v;
+
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        e->ticksPerFrame = 1e9 / e->rate * tb.denom / tb.numer;
+
+        strlcpy(e->info.uid, d->uid, sizeof(e->info.uid));
+        strlcpy(e->info.name, d->name, sizeof(e->info.name));
+        strlcpy(e->info.manufacturer, "PureDarwin", sizeof(e->info.manufacturer));
+        e->info.flags = kPDAudioDeviceHasOutput;
+        e->info.sampleRate = e->rate;
+        e->info.outputChannels = e->channels;
+        e->info.latencyFrames = DEV_QUEUE_FRAMES + DEV_OUTPUT_FRAMES;
+        e->info.volume = DEV_SOFT_VOLUME;
+        if (d->hardwareVolume) {
+            e->info.flags |= kPDAudioDeviceHardwareVolume | kPDAudioDeviceHardwareMute;
+            // the level the driver has now, so starting the server changes nothing that can be heard
+            if (devGet(d, "volume_db", &v))
+                e->info.volume = 1.0f - (float)(v > DEV_RANGE_DB ? DEV_RANGE_DB : v) / DEV_RANGE_DB;
+        }
+        e->info.id = idForUID(e->info.uid);
+
+        CFMutableDictionaryRef p = devicePrefs(e->info.uid, false);
+        CFNumberRef vol = p ? CFDictionaryGetValue(p, CFSTR("Volume")) : NULL;
+        CFBooleanRef mute = p ? CFDictionaryGetValue(p, CFSTR("Mute")) : NULL;
+        if (vol && CFGetTypeID(vol) == CFNumberGetTypeID())
+            CFNumberGetValue(vol, kCFNumberFloat32Type, &e->info.volume);
+        if (mute && CFGetTypeID(mute) == CFBooleanGetTypeID())
+            e->info.mute = CFBooleanGetValue(mute);
+        e->used = true;
+        fprintf(stderr, "coreaudiod: %s (%s) on %s at %u Hz, 2 channels, %s volume\n", e->info.name, e->info.uid, devPath(d),
+                e->rate, d->hardwareVolume ? "hardware" : "software");
+        applyVolume(e);
+        startIOThread(e);
+        added = true;
+    }
+    if (added) {
+        uint32_t what = kPDAudioChangedDevices;
+        if (chooseDefaultsLocked())
+            what |= kPDAudioChangedDefaults;
+        broadcastLocked(what);
+        pthread_cond_broadcast(&sClientsChanged);
+    }
+    return added;
+}
+
+// what is in the jack: 0 nothing, above 0 a plug, below 0 not known
+static int devJack(void)
+{
+    // a file with the number stands in for the driver's sysctl, to try the switch without a plug
+    const char *file = getenv("COREAUDIOD_JACK_FILE");
+    int jack = -1;
+
+    if (file && file[0]) {
+        FILE *f = fopen(file, "r");
+        if (f) {
+            if (fscanf(f, "%d", &jack) != 1)
+                jack = -1;
+            fclose(f);
+        }
+        return jack;
+    }
+    for (size_t i = 0; i < sizeof(sDevTable) / sizeof(sDevTable[0]); i++) {
+        if (sDevTable[i].route == kDevJackPlugged && devGet(&sDevTable[i], "jack", &jack))
+            return jack;
+    }
+    return -1;
+}
+
+// the default output follows the jack: the device for a plug while one is in, the device for none otherwise, each
+// when it is there. Clients on the default move with it at their next period and keep their rings
