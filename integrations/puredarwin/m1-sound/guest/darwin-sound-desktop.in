#!/bin/sh
# SPDX-License-Identifier: MIT
# The whole desktop with sound, unattended: Wi-Fi joins in the background, coreaudiod runs,
# the shared-shell desktop runs on the GL renderer with two terminals and drives itself
# (CHONKSTEP_DARWIN_AUTOPILOT=1: typing, windows, scrollback, brightness keys and the volume
# keys F11 F11 F12 F12 F10 F10, read back from coreaudiod), and meanwhile sound plays through
# the CoreAudio API: on the default output (the speakers, since nothing is plugged in) and
# on the headphone output by name. kern.pd_speaker.hold_probe=1 keeps the speakers 20 dB
# under the model's limit for the whole session; the tones are @SPKDB@ dB below full scale.
# @SSID@/@PSK@ are filled from private/wifi.env at packet assembly; the filled script is
# never committed.
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
case "$nonce" in *[!0-9a-f]*|'') session=000000000000000000000000000000000000000000000001 ;; *) session=$nonce ;; esac
[ "${#session}" -eq 48 ] || session=000000000000000000000000000000000000000000000001
runtime=/private/var/run/sound-desktop
mkdir -p "$runtime" && chmod 0700 "$runtime"
export XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0
export XKB_CONFIG_ROOT=/usr/share/X11/xkb TMPDIR=/private/tmp
export CHONKSTEP_DARWIN_FRAME_STATS=120
[ -d /usr/share/backgrounds/siliconforest ] && export CHONKSTEP_BACKGROUND_DIR=/usr/share/backgrounds/siliconforest
get() { sysctl -n "$1" 2>/dev/null; }
printf '\nSDDESK_BEGIN_%s\n' "$nonce"
sysctl hw.ncpu hw.activecpu 2>&1
printf 'SDDESK_SOUND %s | %s\n' "$(get kern.pd_sound.state)" "$(get kern.pd_speaker.state)"
(
    if command -v wifiutil >/dev/null 2>&1 && [ -d /Library/Firmware/brcm ]; then
        sleep 4; pd-dhcp --up en0 >/dev/null 2>&1; sleep 2
        wifiutil on >/dev/null 2>&1; sleep 8
        wifiutil join '@SSID@' '@PSK@' >/dev/null 2>&1; printf 'SDDESK_WIFI_JOIN_RC=%s\n' "$?"
        sleep 4; pd-net-up en0 >/dev/null 2>&1; printf 'SDDESK_NET_UP_RC=%s\n' "$?"
        ping -c 2 1.1.1.1 >/dev/null 2>&1; printf 'SDDESK_PING_RC=%s\n' "$?"
    else
        printf 'SDDESK_WIFI_SKIPPED\n'
    fi
) &
# the audio server, as the desktop session starts it
sysctl -w kern.pd_speaker.hold_probe=1 kern.pd_sound.volume_db=@VOLUME@ > /dev/null 2>&1
mkdir -p /var/log /Library/Preferences
/usr/sbin/coreaudiod > /var/log/coreaudiod.log 2>&1 &
printf 'SDDESK_COREAUDIOD pid=%s hold_probe=%s\n' "$!" "$(get kern.pd_speaker.hold_probe)"
# sound while the desktop runs
(
    sleep 45
    printf 'SDDESK_VOLUME %s\n' "$(pdvolume get 2>&1 | tail -1)"
    if [ "$(get kern.pd_speaker.hold_probe)" = 1 ]; then
        pdtone -f 440 -s 4 -d @SPKDB@ 2>&1 | tail -2
        printf 'SDDESK_SPEAKERS frames=%s sessions=%s trips=%s model=%s\n' "$(get kern.pd_speaker.frames)" \
            "$(get kern.pd_speaker.sessions)" "$(get kern.pd_speaker.trips)" "$(get kern.pd_speaker.model)"
    fi
    pdtone -u PDAudio:headphones -f 1000 -s 4 -d @TONEDB@ 2>&1 | tail -2
    printf 'SDDESK_HEADPHONES frames=%s sessions=%s late=%s ring_errors=%s i2c_errors=%s jack=%s\n' "$(get kern.pd_sound.frames)" \
        "$(get kern.pd_sound.sessions)" "$(get kern.pd_sound.late)" "$(get kern.pd_sound.ring_errors)" \
        "$(get kern.pd_sound.i2c_errors)" "$(get kern.pd_sound.jack)"
    dd if=/dev/pdmic of=/dev/null bs=4096 count=47 2>/dev/null
    printf 'SDDESK_MIC %s\n' "$(get kern.pd_sound.mic)"
) &
[ -x /usr/bin/darwin-trackpad-enum ] && { /usr/bin/darwin-trackpad-enum --nonce "$session"; printf 'SDDESK_ENUM rc=%s\n' "$?"; }
count=0
while [ ! -c /dev/usb_hid_kbd ] || [ ! -c /dev/usb_hid_mouse ]; do
    count=$((count + 1)); [ "$count" -le 100 ] || break; sleep 0.1
done
printf 'SDDESK_INPUT kbd=%s mouse=%s\n' "$([ -c /dev/usb_hid_kbd ] && echo yes || echo no)" "$([ -c /dev/usb_hid_mouse ] && echo yes || echo no)"
records=$runtime/session-$session
mkdir -m 0700 "$records"
printf 'SDDESK_DESKTOP_START seconds=160 start=%s\n' "$(date +%s)"
CHONKSTEP_DARWIN_AUTOPILOT=1 CHONKSTEP_DARWIN_MAX_TERMINALS=3 /usr/bin/chonkstep-darwin-desktop --run --socket "$runtime/wayland-0" --records "$records" --session "$session" --terminal /usr/bin/chonk-terminal-darwin --seconds 160 --font-regular /usr/share/darwin-desktop/DejaVuSans.ttf --font-bold /usr/share/darwin-desktop/DejaVuSans-Bold.ttf --input pdhid --startup-terminals 2 --renderer gl 2>&1 | grep -v 'chonkstep-gl: step:'
printf 'SDDESK_DESKTOP_END end=%s\n' "$(date +%s)"
[ -r "$records/session-result.txt" ] && grep -v ' gate=\| kernel_messages=\| cs_at_spawn=\| exit_reason=' "$records/session-result.txt" | cut -c1-260 | sed 's/^/SDDESK_RESULT /' | head -40
wait
tail -25 /var/log/coreaudiod.log | sed 's/^/SDDESK_COREAUDIOD_LOG /'
sysctl kern.pd_sound.state kern.pd_sound.sessions kern.pd_sound.frames kern.pd_sound.jack_irqs kern.pd_speaker.state kern.pd_speaker.model \
    kern.pd_speaker.sessions kern.pd_speaker.trips 2>&1
printf 'SDDESK_END_%s\n' "$nonce"
printf '\nPD_BENCH_DONE\n'
