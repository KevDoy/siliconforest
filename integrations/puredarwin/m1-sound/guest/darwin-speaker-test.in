#!/bin/sh
# SPDX-License-Identifier: MIT
# Unattended speaker check for PDAppleSound. Nothing here is audible: no safety daemon
# runs, so the kernel holds every speaker volume at -100 dB, and no step asks for more
# and expects to get it.
#   bringup   the four amplifiers identified; state, lock and registers
#   locked    @SECONDS@ s of the kernel test tone (-30 dBFS) with the lock closed: stream
#             and sense capture counters, registers read back, sense statistics
#   lock      pdspk-test: the volume lock's rules through /dev/pdspeaker-safety
#   writer    two seconds of a tone through /dev/pdspeaker (still -100 dB)
#   both      headphones and speakers playing at once
#   shutdown  the fault path, forced three times: amplifiers off, then speakers disabled
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nSD_BEGIN_%s\n' "$nonce"
t0=$(date +%s)
now() { echo $(( $(date +%s) - t0 )); }
phase() { printf 'SD_PHASE %s t=%s\n' "$1" "$(now)"; }
get() { sysctl -n "$1" 2>/dev/null; }
mon() {
    printf 'SD_SPK %s t=%s playing=%s unlocked=%s owner=%s periods=%s sense_periods=%s rate_mhz=%s trips=%s pings=%s lease_timeouts=%s volume_refused=%s volume_sets=%s\n' \
        "$1" "$(now)" "$(get kern.pd_speaker.playing)" "$(get kern.pd_speaker.unlocked)" "$(get kern.pd_speaker.owner)" \
        "$(get kern.pd_speaker.periods)" "$(get kern.pd_speaker.sense_periods)" "$(get kern.pd_speaker.rate_mhz)" \
        "$(get kern.pd_speaker.trips)" "$(get kern.pd_speaker.pings)" "$(get kern.pd_speaker.lease_timeouts)" \
        "$(get kern.pd_speaker.volume_refused)" "$(get kern.pd_speaker.volume_sets)"
    printf 'SD_SPK_STATE %s %s\n' "$1" "$(get kern.pd_speaker.state)"
    printf 'SD_SPK_VOLUME %s %s\n' "$1" "$(get kern.pd_speaker.volume)"
    printf 'SD_SPK_SENSE %s %s\n' "$1" "$(get kern.pd_speaker.sense)"
}
idle() {
    n=0
    while [ "$(get "$1")" = 1 ] && [ "$n" -lt "$2" ]; do sleep 1; n=$((n+1)); done
    [ "$(get "$1")" = 1 ] && printf 'SD_FAIL %s still 1 after %s s\n' "$1" "$2"
}

phase bringup
n=0
while [ "$n" -lt 40 ]; do
    case "$(get kern.pd_speaker.state)" in idle*|failed*|disabled*) break;; esac
    sleep 1; n=$((n+1))
done
mon bringup
ls -l /dev/pdspeaker /dev/pdspeaker-safety 2>&1
case "$(get kern.pd_speaker.state)" in
idle*) ;;
*)  printf 'SD_FAIL the speakers are not available\n'
    sysctl kern.pd_speaker kern.pd_sound.state 2>&1
    printf 'SD_END_%s\n' "$nonce"; printf '\nPD_BENCH_DONE\n'; exit 0;;
esac

phase locked
sysctl -w kern.pd_speaker.tone_db=30 kern.pd_speaker.tone=@SECONDS@ 2>&1
n=0; while [ "$n" -lt @SECONDS@ ]; do sleep 1; n=$((n+1)); mon locked; done
idle kern.pd_speaker.playing 10
mon locked-end

phase lock
pdspk-test 2>&1
idle kern.pd_speaker.playing 15
mon lock-end

phase writer
dd if=/dev/zero bs=4096 count=94 2>/dev/null > /dev/pdspeaker
idle kern.pd_speaker.playing 10
mon writer-end

phase both
sysctl -w kern.pd_sound.volume_db=@VOLUME@ kern.pd_sound.tone_db=@TONEDB@ kern.pd_sound.tone=4 kern.pd_speaker.tone=4 2>&1
sleep 3
mon both
printf 'SD_BOTH headphones playing=%s periods=%s rate_mhz=%s late=%s\n' "$(get kern.pd_sound.playing)" \
    "$(get kern.pd_sound.periods)" "$(get kern.pd_sound.rate_mhz)" "$(get kern.pd_sound.late)"
idle kern.pd_speaker.playing 10; idle kern.pd_sound.playing 10
mon both-end

phase shutdown
# the fault path, three times: each stops the stream and puts the amplifiers into hardware
# shutdown; after the third the speakers stay off until the next boot
c=0
while [ "$c" -lt 3 ]; do
    sysctl -w kern.pd_speaker.tone=5 > /dev/null 2>&1
    sleep 2
    sysctl -w kern.pd_speaker.test_shutdown=1 2>&1
    sleep 1
    c=$((c+1)); mon shutdown-$c
done
sysctl -w kern.pd_speaker.tone=2 2>&1
sleep 1; mon after-disable

phase end
sysctl kern.pd_speaker 2>&1
sysctl kern.pd_sound.state kern.pd_sound.i2c_errors kern.pd_sound.dart_faults kern.pd_sound.jack_irqs 2>&1
printf 'SD_END_%s\n' "$nonce"
printf '\nPD_BENCH_DONE\n'
