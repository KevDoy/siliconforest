 static int
+do_context_stats(struct pdavd_context_stats *req)
+{
+    if (req->size != sizeof(*req) || req->version != PDAVD_CONTEXT_STATS_VERSION ||
+        req->reserved) return EINVAL;
+    Context *c = context_of(req->ctx);
+    if (!c || c->owner != proc_selfpid() || c->ownerTask != current_task() ||
+        (req->generation && req->generation != c->generation)) return EINVAL;
+    struct pd_avd_stats stats = {};
+    pd_avd_session_stats(c->session, &stats);
+    struct pdavd_context_stats out = {};
+    out.size=sizeof(out);out.version=PDAVD_CONTEXT_STATS_VERSION;out.ctx=req->ctx;
+    out.generation=c->generation;
+    out.flags=PDAVD_CTX_STATS_CORE_VALID|PDAVD_CTX_STATS_CAPTURE_VALID;
+    if (c->imported) out.flags|=PDAVD_CTX_STATS_IMPORTED;
+    if (c->submitted) out.flags|=PDAVD_CTX_STATS_SUBMITTED;
+    if (gDart.poisoned) out.flags|=PDAVD_CTX_STATS_GLOBAL_POISONED;
+    out.jobs=stats.jobs;out.done=stats.done;out.errors=stats.errors;out.timeouts=stats.timeouts;
+    out.last_decode_us=stats.last_decode_us;out.total_decode_us=stats.total_decode_us;
+    out.max_decode_us=stats.max_decode_us;
+    out.capture_buffers=c->buffers;
+    out.api_decode_calls=c->apiDecodeCalls;out.api_decode_errors=c->apiDecodeErrors;
+    for (unsigned i=0;i<c->buffers;i++) {
+        void *cpu=NULL,*cookie=NULL;size_t bytes=0;
+        if (pd_avd_session_buffer(c->session,i,&cpu,&bytes,&cookie) || !cookie) return EIO;
+        DmaCookie *d=(DmaCookie *)cookie;
+        if (d->bytes>SIZE_MAX-16383) return EOVERFLOW;
+        uint64_t rounded=(d->bytes+16383)&~(size_t)16383;
+        if (out.capture_backing_bytes>UINT64_MAX-rounded) return EOVERFLOW;
+        out.capture_backing_bytes+=rounded;
+        if (d->iova) out.capture_iova_bytes+=rounded;
+        if (d->prepared) out.capture_prepared_bytes+=rounded;
+    }
+    *req=out;
+    return 0;
+}
