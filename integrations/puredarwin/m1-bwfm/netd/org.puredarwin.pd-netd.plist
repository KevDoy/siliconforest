<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.puredarwin.pd-netd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/pd-netd</string>
        <string>en0</string>
    </array>
    <key>StandardOutPath</key>
    <string>/var/log/pd-netd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/pd-netd.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
