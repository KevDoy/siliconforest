fbsdkpi: the thread and area tables are allocated at load instead of being .bss

sThreads (8192 slots, 720 KiB) and sAreas (4096 slots, 128 KiB) were static arrays in every
kext that carries the layer; the kernel collection has 16 MiB for all kexts together. They
are now allocated by a static constructor when the kext loads. Same sizes, same behaviour.
(The page hash of patch 0011 is allocated the same way, in lkpi_page_init.)
UPSTREAM: yes (saves 850 KiB of collection space per LinuxKPI kext).

--- a/src/Kernel/fbsdkpi/pd/pd_haiku_kernel.cpp
+++ b/src/Kernel/fbsdkpi/pd/pd_haiku_kernel.cpp
@@ -193,7 +193,9 @@
 	void			*fbsd_thread;	// linuxkpi's struct thread, made on first use
 };
 
-static pd_thread sThreads[PD_THREAD_SLOTS];
+// pd_tables: allocated when the kext loads, not part of the image. As .bss these two tables
+// were 850 KiB of every kext that carries the layer, in a collection with 16 MiB for all kexts.
+static pd_thread *sThreads;
 static spinlock sThreadLock;
 static int32 sNextThreadID = 1;
 
@@ -910,7 +923,18 @@
 
 enum { AREA_FREE = 0, AREA_CONTIG, AREA_PHYS };
 
-static pd_area sAreas[PD_AREA_SLOTS];
+static pd_area *sAreas;
+
+// pd_tables: runs with the kext's other static constructors, before anything can call in
+static struct pd_tables_init {
+	pd_tables_init()
+	{
+		sThreads = (pd_thread *)pdos_malloc(sizeof(pd_thread) * PD_THREAD_SLOTS, 1, 1);
+		sAreas = (pd_area *)pdos_malloc(sizeof(pd_area) * PD_AREA_SLOTS, 1, 1);
+		if (sThreads == NULL || sAreas == NULL)
+			panic("pd: no memory for the thread and area tables");
+	}
+} sTablesInit;
 static spinlock sAreaLock;
 static int32 sNextArea = 1;
 
