+	else
+		lck_rw_init((lck_rw_t *)storage, sGroup, LCK_ATTR_NULL);
+	OSAddAtomic64(1, (SInt64 *)&sLockSetups);
+}
+
+int64_t
+pdos_lock_allocated(void)
