fbsdkpi: xnu seam: non-blocking pdos_malloc, locks in caller storage, counters

pdos_malloc ignored `canwait` (IOMalloc always may block). It now uses kalloc_data, the kpi
that takes Z_NOWAIT. pdos_mtx_setup/pdos_rw_setup make an unlocked xnu lock in 16 bytes of
caller storage, so the Haiku locks above no longer allocate (next patch). Counters for tests.
UPSTREAM: yes.

--- a/src/Kernel/fbsdkpi/pd_fbsd_os.h
+++ b/src/Kernel/fbsdkpi/pd_fbsd_os.h
@@ -26,7 +26,17 @@
 void pdos_sleep_us(uint64_t us);
 
 // memory, sizes are remembered by the backend
+// canwait 0 never blocks (xnu Z_NOWAIT): it may be called with locks held and with
+// preemption disabled, and fails rather than wait. It can only be served from the kalloc
+// zones, so a request above their limit (32 KiB on 16 KiB-page kernels, less the headers)
+// fails when it may not wait.
 void *pdos_malloc(size_t size, int zero, int canwait);
+// allocations that were made with canwait 0 and succeeded, for tests
+uint64_t pdos_malloc_nowait_count(void);
+// bytes handed out by pdos_malloc and not yet freed
+int64_t pdos_malloc_live(void);
+// the kernel's page size
+size_t pdos_page_size(void);
 void pdos_free(void *ptr);
 size_t pdos_malloc_size(void *ptr);
 void *pdos_malloc_contig(size_t size, size_t align, uint64_t maxaddr, uint64_t *phys);
@@ -50,6 +60,16 @@
 int pdos_dma_has_mapper(void *pcidev);
 
 // sleepable mutexes, kernel thread context only
+// pdos_mtx_setup and pdos_rw_setup make an unlocked xnu lock in two words of caller storage
+// (PD_LOCK_STORAGE); such a lock needs no teardown. The alloc/free pairs remain for callers
+// that want a separately allocated lock.
+#define PD_LOCK_STORAGE	16
+void pdos_mtx_setup(void *storage);
+void pdos_rw_setup(void *storage);
+// xnu locks currently allocated through pdos_mtx_alloc, pdos_rw_alloc and pdos_spin_alloc,
+// and embedded locks set up so far
+int64_t pdos_lock_allocated(void);
+uint64_t pdos_lock_setups(void);
 void *pdos_mtx_alloc(const char *name);
 void pdos_mtx_free(void *m);
 void pdos_mtx_lock(void *m);
--- a/src/Kernel/fbsdkpi/xnu/pd_fbsd_os.cpp
+++ b/src/Kernel/fbsdkpi/xnu/pd_fbsd_os.cpp
@@ -15,6 +15,7 @@
 #include <IOKit/acpi/IOACPIPlatformExpert.h>
 #define PDOS_HAVE_ACPI 1
 #endif
+#include <kern/kalloc.h>
 #include <kern/locks.h>
 #include <kern/thread.h>
 #include <kern/thread_call.h>
@@ -39,12 +40,41 @@
 static lck_spin_t *sWaitLock;
 static lck_mtx_t *sListLock;
 
+// Embedded locks (pdos_mtx_setup, pdos_rw_setup) are copies of these two. lck_mtx_init and
+// lck_rw_init only fill the lock's own words (type, group id, flags) and count it in the
+// group; a copy is the same unlocked lock without the count, so it needs no lck_*_destroy,
+// and creating locks without ever destroying them cannot run the group's reference count
+// up. That an initialised lock does not depend on its address is checked on the running
+// kernel in pdos_xnu_init; if it ever did, each embedded lock is initialised in place.
+_Static_assert(sizeof(lck_mtx_t) <= PD_LOCK_STORAGE, "lck_mtx_t does not fit the embedded lock storage");
+_Static_assert(sizeof(lck_rw_t) <= PD_LOCK_STORAGE, "lck_rw_t does not fit the embedded lock storage");
+static lck_mtx_t sMtxTemplate;
+static lck_rw_t sRwTemplate;
+static bool sLockTemplates;
+static int64_t sLocksAllocated;
+static uint64_t sLockSetups;
+static uint64_t sNowaitAllocs;
+static int64_t sLiveBytes;
+
 void
 pdos_xnu_init(void)
 {
 	if (sGroup != NULL)
 		return;
-	sGroup = lck_grp_alloc_init("fbsdkpi", LCK_GRP_ATTR_NULL);
+	lck_grp_t *group = lck_grp_alloc_init("fbsdkpi", LCK_GRP_ATTR_NULL);
+	lck_mtx_t mtx;
+	lck_rw_t rw;
+	lck_mtx_init(&sMtxTemplate, group, LCK_ATTR_NULL);
+	lck_mtx_init(&mtx, group, LCK_ATTR_NULL);
+	lck_rw_init(&sRwTemplate, group, LCK_ATTR_NULL);
+	lck_rw_init(&rw, group, LCK_ATTR_NULL);
+	sLockTemplates = memcmp(&mtx, &sMtxTemplate, sizeof(mtx)) == 0
+		&& memcmp(&rw, &sRwTemplate, sizeof(rw)) == 0;
+	lck_mtx_destroy(&mtx, group);
+	lck_rw_destroy(&rw, group);
+	if (!sLockTemplates)
+		IOLog("fbsdkpi: xnu locks depend on their address, embedded locks are initialised in place\n");
+	sGroup = group;
 	sWaitLock = lck_spin_alloc_init(sGroup, LCK_ATTR_NULL);
 	sListLock = lck_mtx_alloc_init(sGroup, LCK_ATTR_NULL);
 }
@@ -136,15 +166,22 @@
 	size_t		pad;
 };
 
+// kalloc_data rather than IOMalloc: it is the kpi that takes Z_NOWAIT. A Z_NOWAIT request
+// is served from a kalloc zone without blocking or not at all (kalloc_large returns NULL for
+// it), so it is safe under locks and with preemption disabled.
 void *
 pdos_malloc(size_t size, int zero, int canwait)
 {
-	pd_block *block = (pd_block *)IOMalloc(size + sizeof(pd_block));
+	if (size + sizeof(pd_block) < size)
+		return NULL;
+	int flags = (canwait ? Z_WAITOK : Z_NOWAIT) | (zero ? Z_ZERO : 0);
+	pd_block *block = (pd_block *)kalloc_data(size + sizeof(pd_block), (zalloc_flags_t)flags);
 	if (block == NULL)
 		return NULL;
 	block->size = size;
-	if (zero)
-		bzero(block + 1, size);
+	if (!canwait)
+		OSAddAtomic64(1, (SInt64 *)&sNowaitAllocs);
+	OSAddAtomic64((SInt64)size, (SInt64 *)&sLiveBytes);
 	return block + 1;
 }
 
@@ -154,7 +191,26 @@
 	if (ptr == NULL)
 		return;
 	pd_block *block = (pd_block *)ptr - 1;
-	IOFree(block, block->size + sizeof(pd_block));
+	OSAddAtomic64(-(SInt64)block->size, (SInt64 *)&sLiveBytes);
+	kfree_data(block, block->size + sizeof(pd_block));
+}
+
+int64_t
+pdos_malloc_live(void)
+{
+	return sLiveBytes;
+}
+
+uint64_t
+pdos_malloc_nowait_count(void)
+{
+	return sNowaitAllocs;
+}
+
+size_t
+pdos_page_size(void)
+{
+	return PAGE_SIZE;
 }
 
