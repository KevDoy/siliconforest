+// kalloc_data rather than IOMalloc: it is the kpi that takes Z_NOWAIT. A Z_NOWAIT request
+// is served from a kalloc zone without blocking or not at all (kalloc_large returns NULL for
+// it), so it is safe under locks and with preemption disabled.
+static volatile int64_t sNowaitRetried;
+int64_t
+pdos_malloc_nowait_retried(void)
+{
+	return sNowaitRetried;
+}
+
 void *
 pdos_malloc(size_t size, int zero, int canwait)
 {
-	pd_block *block = (pd_block *)IOMalloc(size + sizeof(pd_block));
+	if (size + sizeof(pd_block) < size)
+		return NULL;
+	int flags = (canwait ? Z_WAITOK : Z_NOWAIT) | (zero ? Z_ZERO : 0);
+	pd_block *block = (pd_block *)kalloc_data(size + sizeof(pd_block), (zalloc_flags_t)flags);
+	// Z_NOWAIT fails whenever the zone has to grow, which is routine, while Linux's
+	// GFP_ATOMIC/GFP_NOWAIT and FreeBSD's M_NOWAIT rarely fail (reserves). Nearly every
+	// "atomic" caller in this layer is a thread that may block (its spinlocks are mutexes,
+	// its interrupt handlers run on threads), so when the thread really can block, wait.
+	if (block == NULL && !canwait && !ml_at_interrupt_context() && ml_get_interrupts_enabled() &&
+	    preemption_enabled()) {
+		block = (pd_block *)kalloc_data(size + sizeof(pd_block),
+		    (zalloc_flags_t)(Z_WAITOK | (zero ? Z_ZERO : 0)));
+		if (block != NULL)
+			OSAddAtomic64(1, (SInt64 *)&sNowaitRetried);
+	}
 	if (block == NULL)
 		return NULL;
 	block->size = size;
-	if (zero)
-		bzero(block + 1, size);
+	if (!canwait)
+		OSAddAtomic64(1, (SInt64 *)&sNowaitAllocs);
+	OSAddAtomic64((SInt64)size, (SInt64 *)&sLiveBytes);
 	return block + 1;
 }
 
