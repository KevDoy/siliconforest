+// for a kext's diagnostics: pool state and why allocations failed
+void
+pd_linux_page_stats(unsigned long *chunks, unsigned long *free_pages, unsigned long *chunk_allocs,
+    unsigned long *chunk_frees, unsigned long *fail_xnu, unsigned long *fail_record)
+{
+	mtx_lock(&pd_page_lock);
+	*chunks = pd_pool_chunks;
+	*free_pages = pd_pool_free;
+	*chunk_allocs = pd_pool_chunk_allocs;
+	*chunk_frees = pd_pool_chunk_frees;
+	*fail_xnu = pd_page_fail_xnu;
+	*fail_record = pd_page_fail_record;
+	mtx_unlock(&pd_page_lock);
+}
