+// pd_pool: single pages (alloc_page, every shmem/GEM page, page tables) come from chunks of
+// PD_CHUNK_PAGES wired pages, one xnu allocation each (pdos_pages_alloc). Before this every
+// page was its own physically-contiguous IOBufferMemoryDescriptor with its own records.
+// A chunk goes back to xnu when all its pages are free, nothing maps it and the pool still
+// holds PD_POOL_KEEP free pages elsewhere.
+#define PD_CHUNK_PAGES	64
+#define PD_POOL_KEEP	(4 * PD_CHUNK_PAGES)
+static struct pd_page_run *pd_pool_partial;	// chunks with a free page
+static unsigned long pd_pool_free, pd_pool_chunks, pd_pool_chunk_allocs, pd_pool_chunk_frees;
+static unsigned long pd_page_fail_xnu, pd_page_fail_record;
