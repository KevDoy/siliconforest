 }
 
+static void
+pd_pool_link(struct pd_page_run *run)
+{
+	run->pnext = pd_pool_partial;
+	run->pprevp = &pd_pool_partial;
+	if (pd_pool_partial != NULL)
+		pd_pool_partial->pprevp = &run->pnext;
+	pd_pool_partial = run;
+}
+
+static void
+pd_pool_unlink(struct pd_page_run *run)
+{
+	*run->pprevp = run->pnext;
+	if (run->pnext != NULL)
+		run->pnext->pprevp = run->pprevp;
+	run->pnext = NULL;
+	run->pprevp = NULL;
+}
+
+// one more chunk into the pool; false when xnu has no memory
+static bool
+pd_pool_grow(void)
+{
+	uint64_t phys[PD_CHUNK_PAGES];
+	struct pd_page_run *run;
+	void *cookie = NULL, *kva;
+	unsigned long i;
+
+	kva = pdos_pages_alloc(PD_CHUNK_PAGES, phys, &cookie);
+	if (kva == NULL) {
+		pd_page_fail_xnu++;
+		return false;
+	}
+	run = malloc(sizeof(*run) + PD_CHUNK_PAGES * sizeof(struct vm_page), M_DEVBUF, M_WAITOK | M_ZERO);
+	if (run == NULL) {
+		pd_page_fail_record++;
+		pdos_pages_free(cookie);
+		return false;
+	}
+	run->phys = phys[0];
+	run->kva = kva;
+	run->npages = PD_CHUNK_PAGES;
+	run->pooled = true;
+	run->cookie = cookie;
+	run->freemask = ~0ULL;
+
+	mtx_lock(&pd_page_lock);
+	for (i = 0; i < PD_CHUNK_PAGES; i++) {
+		vm_page_t m = &run->pages[i];
+		unsigned b;
+
+		m->phys_addr = phys[i];
+		m->pd_kva = (char *)kva + (i << PAGE_SHIFT);
+		m->pd_run = run;
+		b = pd_page_bucket(m->phys_addr);
+		m->pd_hnext = pd_page_hash[b];
+		pd_page_hash[b] = m;
+	}
+	pd_pool_link(run);
+	pd_pool_free += PD_CHUNK_PAGES;
+	pd_pool_chunks++;
+	pd_pool_chunk_allocs++;
+	mtx_unlock(&pd_page_lock);
+	return true;
+}
+
+static struct page *
+pd_pool_alloc(gfp_t flags)
+{
+	struct pd_page_run *run;
+	vm_page_t m;
+	int i;
+
+	for (;;) {
+		mtx_lock(&pd_page_lock);
+		run = pd_pool_partial;
+		if (run != NULL)
+			break;
+		mtx_unlock(&pd_page_lock);
+		if (!pd_pool_grow())
+			return NULL;
+	}
+	i = __builtin_ctzll(run->freemask);
+	run->freemask &= ~(1ULL << i);
+	if (run->freemask == 0)
+		pd_pool_unlink(run);
+	pd_pool_free--;
+	m = &run->pages[i];
+	m->ref_count = 1;
+	mtx_unlock(&pd_page_lock);
+	if ((flags & M_ZERO) != 0)
+		memset(m->pd_kva, 0, PAGE_SIZE);
+	return m;
+}
+
+static void
+pd_pool_free_page(struct page *page)
+{
+	struct pd_page_run *run = page->pd_run;
+	int i = (int)(page - run->pages);
+	bool release;
+
+	if (page->pd_kva_cached != NULL) {
+		pdos_unmap_pages(page->pd_kva);
+		page->pd_kva = page->pd_kva_cached;
+		page->pd_kva_cached = NULL;
+	}
+	mtx_lock(&pd_page_lock);
+	page->ref_count = 0;
+	page->flags = 0;
+	page->object = NULL;
+	if (run->freemask == 0)
+		pd_pool_link(run);
+	run->freemask |= 1ULL << i;
+	pd_pool_free++;
+	release = run->freemask == ~0ULL && run->vmaps == 0 &&
+	    pd_pool_free >= PD_POOL_KEEP + PD_CHUNK_PAGES;
+	if (release) {
+		pd_pool_unlink(run);
+		pd_page_run_unhash(run);
+		pd_pool_free -= PD_CHUNK_PAGES;
+		pd_pool_chunks--;
+		pd_pool_chunk_frees++;
+	}
+	mtx_unlock(&pd_page_lock);
+	if (release) {
+		pdos_pages_free(run->cookie);
+		free(run, M_DEVBUF);
+	}
+}
