 static struct mutex pd_of_nodes_lock;
-static int pd_of_nodes_lock_ready;
 
 static struct mutex *
 pd_of_nodes_lock_get(void)
 {
-	if (!pd_of_nodes_lock_ready) {
-		mutex_init(&pd_of_nodes_lock);
-		pd_of_nodes_lock_ready = 1;
-	}
 	return (&pd_of_nodes_lock);
 }
 

