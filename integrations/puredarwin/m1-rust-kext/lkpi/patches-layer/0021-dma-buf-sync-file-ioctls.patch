fbsdkpi: drm: DMA_BUF_IOCTL_EXPORT_SYNC_FILE and IMPORT_SYNC_FILE

Both returned ENOTTY. Mesa calls them for every shared buffer on every submission and
falls back to waiting on the CPU when they fail. dma_buf_export_sync_file() and
dma_buf_import_sync_file() of the pin's drivers/dma-buf/dma-buf.c (lines 450-551), compared
line by line, on the layer's dma_resv, dma_fence_unwrap and sync_file.
UPSTREAM: yes.

--- a/src/Kernel/fbsdkpi/drm/src/pd_dma_buf.c
+++ b/src/Kernel/fbsdkpi/drm/src/pd_dma_buf.c
@@ -3,6 +3,10 @@
 // buffers go to userspace as file descriptors, one linux file per exported buffer
 
 // file.h renames struct file, so it comes before the dma-buf header uses it
+#include <linux/uaccess.h>
+#include <linux/sync_file.h>
+#include <linux/dma-fence-unwrap.h>
+#include <linux/dma-fence.h>
 #include <linux/fs.h>
 #include <linux/file.h>
 #include <linux/ioctl.h>
@@ -94,10 +98,109 @@
 	return 0;
 }
 
+// DMA_BUF_IOCTL_EXPORT_SYNC_FILE / IMPORT_SYNC_FILE: dma_buf_export_sync_file() and
+// dma_buf_import_sync_file() of drivers/dma-buf/dma-buf.c at the pin (linux-aurora 6a08a08e,
+// lines 450-551), statement for statement, with include/uapi/linux/dma-buf.h's layouts: the
+// buffer's implicit-sync fences as a sync_file, and a sync_file's fences added to the buffer.
+// mesa calls both for every shared buffer on every submission.
+struct pd_dma_buf_sync_file {
+	uint32_t flags;		// DMA_BUF_SYNC_READ 1, DMA_BUF_SYNC_WRITE 2
+	int32_t fd;
+};
+#define PD_DMA_BUF_SYNC_READ	(1 << 0)
+#define PD_DMA_BUF_SYNC_WRITE	(2 << 0)
+#define PD_DMA_BUF_SYNC_RW	(PD_DMA_BUF_SYNC_READ | PD_DMA_BUF_SYNC_WRITE)
+#define PD_DMA_BUF_IOCTL_EXPORT_SYNC_FILE	_IOWR('b', 2, struct pd_dma_buf_sync_file)
+#define PD_DMA_BUF_IOCTL_IMPORT_SYNC_FILE	_IOW('b', 3, struct pd_dma_buf_sync_file)
+
+static long
+pd_dma_buf_export_sync_file(struct dma_buf *db, unsigned long uarg)
+{
+	struct pd_dma_buf_sync_file arg;
+	struct dma_fence *fence = NULL;
+	struct sync_file *sf;
+	int fd, ret;
+
+	if (copy_from_user(&arg, (void *)uarg, sizeof(arg)) != 0)
+		return -EFAULT;
+	if ((arg.flags & ~PD_DMA_BUF_SYNC_RW) != 0 || (arg.flags & PD_DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0)
+		return fd;
+	// a reader waits for writers, a writer for everybody
+	ret = dma_resv_get_singleton(db->resv,
+	    dma_resv_usage_rw((arg.flags & PD_DMA_BUF_SYNC_WRITE) != 0), &fence);
+	if (ret != 0)
+		goto err_fd;
+	if (fence == NULL)
+		fence = dma_fence_get_stub();
+	sf = sync_file_create(fence);
+	dma_fence_put(fence);
+	if (sf == NULL) {
+		ret = -ENOMEM;
+		goto err_fd;
+	}
+	arg.fd = fd;
+	if (copy_to_user((void *)uarg, &arg, sizeof(arg)) != 0) {
+		fput(sf->file);
+		ret = -EFAULT;
+		goto err_fd;
+	}
+	fd_install(fd, sf->file);
+	return 0;
+
+err_fd:
+	put_unused_fd(fd);
+	return ret;
+}
+
+static long
+pd_dma_buf_import_sync_file(struct dma_buf *db, unsigned long uarg)
+{
+	struct pd_dma_buf_sync_file arg;
+	struct dma_fence *fence, *f;
+	struct dma_fence_unwrap iter;
+	enum dma_resv_usage usage;
+	unsigned int n = 0;
+	int ret;
+
+	if (copy_from_user(&arg, (void *)uarg, sizeof(arg)) != 0)
+		return -EFAULT;
+	if ((arg.flags & ~PD_DMA_BUF_SYNC_RW) != 0 || (arg.flags & PD_DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+	fence = sync_file_get_fence(arg.fd);
+	if (fence == NULL)
+		return -EINVAL;
+	usage = (arg.flags & PD_DMA_BUF_SYNC_WRITE) != 0 ? DMA_RESV_USAGE_WRITE : DMA_RESV_USAGE_READ;
+	dma_fence_unwrap_for_each(f, &iter, fence)
+		n++;
+	// as the pin's dma_buf_import_sync_file(): a sync file whose fences have all signalled
+	// unwraps to nothing, and then the reservation object is not touched at all
+	ret = 0;
+	if (n > 0) {
+		dma_resv_lock(db->resv, NULL);
+		ret = dma_resv_reserve_fences(db->resv, n);
+		if (ret == 0) {
+			dma_fence_unwrap_for_each(f, &iter, fence)
+				dma_resv_add_fence(db->resv, f, usage);
+		}
+		dma_resv_unlock(db->resv);
+	}
+	dma_fence_put(fence);
+	return ret;
+}
+
 // DMA_BUF_IOCTL_SYNC brackets cpu access, a no-op for coherent buffers
 static long
 pd_dma_buf_file_ioctl(struct linux_file *filp, unsigned int cmd, unsigned long arg)
 {
+	struct dma_buf *db = filp->private_data;
+
+	if (cmd == PD_DMA_BUF_IOCTL_EXPORT_SYNC_FILE)
+		return pd_dma_buf_export_sync_file(db, arg);
+	if (cmd == PD_DMA_BUF_IOCTL_IMPORT_SYNC_FILE)
+		return pd_dma_buf_import_sync_file(db, arg);
 	return cmd == _IOW('b', 0, uint64_t) ? 0 : -ENOTTY;
 }
 
