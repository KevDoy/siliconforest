+// YES when KEY's setter on an object of CLASS notifies by itself (it was wrapped)
+BOOL _NSKVOSetterNotifies(Class class, SEL setter) {
+#if defined(__arm64__)
+    Method method = class_getInstanceMethod(class, setter);
+    IMP imp = method ? method_getImplementation(method) : NULL;
+
+    return (char *)imp >= (char *)NSKVOSetterThunks && (char *)imp < (char *)NSKVOSetterThunks + 8 * NSKVO_SETTER_SLOTS;
+#else
+    return NO;
+#endif
+}
+
+static void NSKVOEnsureAutomaticSetter(Class class, NSString *key) {
+#if defined(__arm64__)
+    const char *name = [key UTF8String];
+    char buffer[256];
+
+    if (name == NULL || name[0] == 0 || name[0] == '@' || strlen(name) > 240)
+        return;
+    if (![class automaticallyNotifiesObserversForKey:key])
+        return;
+    for (int form = 0; form < 2; form++) {
+        snprintf(buffer, sizeof(buffer), form == 0 ? "set%c%s:" : "_set%c%s:", toupper(name[0]), name + 1);
+
+        SEL selector = sel_getUid(buffer);
+        Method method = class_getInstanceMethod(class, selector);
+
+        if (method == NULL)
+            continue;
+
+        IMP imp = method_getImplementation(method);
+        const char *types = method_getTypeEncoding(method);
+
+        // a setter returns nothing and takes one argument; leave anything else alone
+        if (types == NULL || types[0] != 'v' || method_getNumberOfArguments(method) != 3)
+            continue;
+        [observationLock() lock];
+        if (!((char *)imp >= (char *)NSKVOSetterThunks && (char *)imp < (char *)NSKVOSetterThunks + 8 * NSKVO_SETTER_SLOTS) && wrappedSetterCount < NSKVO_SETTER_SLOTS) {
+            int index = wrappedSetterCount++;
+
+            wrappedSetters[index].original = imp;
+            wrappedSetters[index].key = [key copy];
+            wrappedSetters[index].selector = selector;
+            method_setImplementation(method, (IMP)((char *)NSKVOSetterThunks + 8 * index));
+        }
+        [observationLock() unlock];
+    }
+#endif
+}
