+// ---- setters that notify -------------------------------------------------------------------
+// One eight-byte entry per wrapped setter loads its index and enters the common code, which
+// keeps every argument register, calls NSKVOSetterWill (which answers the original
+// implementation), calls that with the arguments as they came, and then NSKVOSetterDid.
+// Arguments passed on the stack are not carried over: a setter takes one argument, and the
+// structures AppKit and Foundation pass (points, sizes, rectangles, ranges) travel in registers.
+#define NSKVO_SETTER_SLOTS 2048
+static struct { IMP original; NSString *key; Class owner; SEL selector; } wrappedSetters[NSKVO_SETTER_SLOTS];
+static int wrappedSetterCount;
+
+#if defined(__arm64__)
+extern void NSKVOSetterThunks(void);
+
+IMP NSKVOSetterWill(id self, unsigned long index) __asm__("_NSKVOSetterWill");
+void NSKVOSetterDid(id self, unsigned long index) __asm__("_NSKVOSetterDid");
+
+IMP NSKVOSetterWill(id self, unsigned long index) {
+    [self willChangeValueForKey:wrappedSetters[index].key];
+    return wrappedSetters[index].original;
+}
+
+void NSKVOSetterDid(id self, unsigned long index) {
+    [self didChangeValueForKey:wrappedSetters[index].key];
+}
+
+__asm__(
+"   .text                                   \n"
+"   .p2align 2                              \n"
+"   .globl _NSKVOSetterThunks               \n"
+"   .private_extern _NSKVOSetterThunks      \n"
+"_NSKVOSetterThunks:                        \n"
+"   .set LNSKVOIndex, 0                     \n"
+"   .rept 2048                              \n"
+"   mov w17, #LNSKVOIndex                   \n"
+"   b LNSKVOSetterCommon                    \n"
+"   .set LNSKVOIndex, LNSKVOIndex + 1       \n"
+"   .endr                                   \n"
+"LNSKVOSetterCommon:                        \n"
+"   .cfi_startproc                          \n"
+"   stp x29, x30, [sp, #-0xb0]!             \n"
+"   .cfi_def_cfa_offset 0xb0                \n"
+"   .cfi_offset w29, -0xb0                  \n"
+"   .cfi_offset w30, -0xa8                  \n"
+"   mov x29, sp                             \n"
+"   .cfi_def_cfa w29, 0xb0                  \n"
+"   stp x19, x20, [sp, #0x10]               \n"
+"   .cfi_offset w19, -0xa0                  \n"
+"   .cfi_offset w20, -0x98                  \n"
+"   stp x0, x1, [sp, #0x20]                 \n"
+"   stp x2, x3, [sp, #0x30]                 \n"
+"   stp x4, x5, [sp, #0x40]                 \n"
+"   stp x6, x7, [sp, #0x50]                 \n"
+"   str x8, [sp, #0x60]                     \n"
+"   stp d0, d1, [sp, #0x70]                 \n"
+"   stp d2, d3, [sp, #0x80]                 \n"
+"   stp d4, d5, [sp, #0x90]                 \n"
+"   stp d6, d7, [sp, #0xa0]                 \n"
+"   mov x19, x0                             \n"
+"   mov x20, x17                            \n"
+"   mov x1, x17                             \n"
+"   bl _NSKVOSetterWill                     \n"
+"   mov x17, x0                             \n"
+"   ldp x0, x1, [sp, #0x20]                 \n"
+"   ldp x2, x3, [sp, #0x30]                 \n"
+"   ldp x4, x5, [sp, #0x40]                 \n"
+"   ldp x6, x7, [sp, #0x50]                 \n"
+"   ldr x8, [sp, #0x60]                     \n"
+"   ldp d0, d1, [sp, #0x70]                 \n"
+"   ldp d2, d3, [sp, #0x80]                 \n"
+"   ldp d4, d5, [sp, #0x90]                 \n"
+"   ldp d6, d7, [sp, #0xa0]                 \n"
+"   blr x17                                 \n"
+"   stp x0, x1, [sp, #0x20]                 \n"
+"   stp d0, d1, [sp, #0x70]                 \n"
+"   stp d2, d3, [sp, #0x80]                 \n"
+"   mov x0, x19                             \n"
+"   mov x1, x20                             \n"
+"   bl _NSKVOSetterDid                      \n"
+"   ldp x0, x1, [sp, #0x20]                 \n"
+"   ldp d0, d1, [sp, #0x70]                 \n"
+"   ldp d2, d3, [sp, #0x80]                 \n"
+"   ldp x19, x20, [sp, #0x10]               \n"
+"   ldp x29, x30, [sp], #0xb0               \n"
+"   .cfi_def_cfa wsp, 0                     \n"
+"   .cfi_restore w19                        \n"
+"   .cfi_restore w20                        \n"
