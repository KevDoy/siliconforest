+    if ([name isEqualToString:@"@unionOfObjects"])
+        return values;
+    if ([name isEqualToString:@"@distinctUnionOfObjects"])
+        return [[NSSet setWithArray:values] allObjects];
+    if ([name isEqualToString:@"@sum"] || [name isEqualToString:@"@avg"]) {
+        double total = 0;
