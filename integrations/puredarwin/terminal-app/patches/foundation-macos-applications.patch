+- (void)enumerateRangesUsingBlock:(void (^)(NSRange range, BOOL *stop))block {
+    NSUInteger count = self->_rangeCount;
+    NSRange *copy = malloc(sizeof(NSRange) * (count ? count : 1));
+    memcpy(copy, self->_ranges, sizeof(NSRange) * count);
+    for (NSUInteger i = 0; i < count; i++) {
