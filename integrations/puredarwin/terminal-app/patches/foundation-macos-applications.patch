+- (NSUInteger)countOfIndexesInRange:(NSRange)range {
+    NSUInteger total = 0;
+    for (NSUInteger i = 0; i < self->_rangeCount; i++) {
+        NSRange common = NSIntersectionRange(self->_ranges[i], range);
+        total += common.length;
+    }
