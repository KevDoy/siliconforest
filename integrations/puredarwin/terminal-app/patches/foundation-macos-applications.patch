+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeDirectory]];
+    else if ([key isEqualToString:@"NSURLIsRegularFileKey"])
+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeRegular]];
+    else if ([key isEqualToString:@"NSURLIsSymbolicLinkKey"])
+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeSymbolicLink]];
+    else if ([key isEqualToString:@"NSURLIsAliasFileKey"])
+        answer = [NSNumber numberWithBool:NO];
