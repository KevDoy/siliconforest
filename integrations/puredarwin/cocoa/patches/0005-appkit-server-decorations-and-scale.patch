+/* The compositor maximised the window, put it away or brought it back, from the buttons of
+ * the frame it draws. The window is the application's all the same: its zoomed and
+ * miniaturised state follow, with the notifications and delegate calls a click on AppKit's
+ * own buttons would have produced. The size itself arrives as a configure. */
+-(void)_serverDidSetState:(NSNumber *)state {
+   int bits=[state intValue],was=_serverState;
+
+   _serverState=bits;
+   if((bits^was)&WS_STATE_SUSPENDED){
+    if(bits&WS_STATE_SUSPENDED){
+     [self postNotificationName:NSWindowWillMiniaturizeNotification];
+     [self postNotificationName:NSWindowDidMiniaturizeNotification];
+    }
+    else
+     [self postNotificationName:NSWindowDidDeminiaturizeNotification];
+   }
+   if((bits^was)&WS_STATE_MAXIMIZED)
+    [_backgroundView setNeedsDisplay:YES];
+}
+
+/* The compositor's answer about this window's frame differs from what the window was laid out
+ * for. Refused server-side decoration: from now on AppKit draws frames itself, and this
+ * window grows by its title bar around the same content. */
+-(void)_serverDidSetDecoration:(NSNumber *)server {
+   if([server boolValue] || !NSWindowFrameIsDrawnByServer(_styleMask))
+    return;
+   NSRect content=[self contentRectForFrameRect:_frame];
+   pdServerFramesRefused=YES;
+   NSRect frame=[self frameRectForContentRect:content];
+   NSSize oldSize=[_backgroundView frame].size;
+   _frame.size=NSMakeSize(oldSize.width+1,oldSize.height);   // the frame view must tile again even at an equal size
+   [self setFrame:frame display:YES];
+}
