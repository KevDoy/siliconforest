+// the size limits as the compositor needs them: its resize stops where AppKit's would
+-(void)_sendSizeLimits {
+   NSSize min=_minSize,max=_maxSize;
+   if(!(_styleMask&NSResizableWindowMask))
+    min=max=_frame.size;
+   struct wsRPCWindow data = {
+       { kWSWindowSetSizeLimits, sizeof(struct wsRPCWindow) - sizeof(struct wsRPCBase) },
+       _number, min.width, min.height,
+       max.width>=32767 ? 0 : max.width, max.height>=32767 ? 0 : max.height, _styleMask, 0, {'\0'}, _level
+   };
+   _windowServerRPC(&data, sizeof(data), NULL, NULL);
+}
