+/* (TERM10) Wheel steps as a trackpad's scrolling. The M1's trackpad reaches the desk as wheel steps (its driver makes one
+ * step of each 3.6 mm of two-finger travel, as libinput with Omarchy's scroll factor would), and a step was one line:
+ * Firefox moved 19 points for 3.6 mm of finger travel, a third of what a Mac's trackpad gives. On macOS a trackpad
+ * scrolls in points, roughly with the pointer's tracking (the desk's: 14 points per mm up to 100 mm/s, 44 at 400 mm/s),
+ * as a gesture (began, changed, ended) and goes on by itself after the fingers lift (momentum). So a step is sent as
+ * precise points: 50 at slow finger speed, up to 3.5 times that when fast, times the system's scroll speed (the file
+ * /private/var/db/desktop-state/chonkstep/scroll-speed, percent, 25..400, default 100, read again within a second of a
+ * change); a pause (2.5 steps at the speed the fingers had, 90 to 200 ms) ends the gesture, and after three or more steps
+ * a momentum phase follows with the speed they had, slowing as macOS's
+ * does. A new step stops the momentum. PD_WS_WHEEL_LINES=1: steps as lines, as before. Mods bits for AppKit: 1 precise,
+ * 2 began, 4 ended, 8 momentum. */
+#define SF_STEP_MM 3.56
+#define SF_STEP_POINTS 50.0
+static struct {
+    pthread_mutex_t lock;
+    pthread_cond_t wake;
+    int started, active, window, axis;   // the gesture: its window and the axis it moves
+    uint64_t lastNs, endAt;              // the last step, when the gesture ends unless another step comes
+    double rate;                         // steps per second, smoothed
+    double recentPts[8]; uint64_t recentNs[8]; unsigned recent;
+    int momentum; double velocity;       // points per second while the momentum lasts
+    unsigned gestureSteps;               // steps since the gesture began
+    double speed; uint64_t speedCheckedNs; time_t speedMtime;
+    double x, y;                         // where the pointer was at the last step, in the window's coordinates
+} sfWheel = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER };
+
+static uint64_t sfMonoNs(void){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return (uint64_t)t.tv_sec*1000000000ull+(uint64_t)t.tv_nsec;}
+static int sfWheelLines(void){static int on=-1;if(on<0){const char *e=getenv("PD_WS_WHEEL_LINES");on=e&&!strcmp(e,"1");}return on;}
+
+// the system's scroll speed in percent, from the desk's state directory (lock held)
+static double sfWheelSpeed(uint64_t now){
+    if(sfWheel.speed<=0||now-sfWheel.speedCheckedNs>1000000000ull){
+        struct stat st;sfWheel.speedCheckedNs=now;
+        if(stat("/private/var/db/desktop-state/chonkstep/scroll-speed",&st)!=0){sfWheel.speed=100;sfWheel.speedMtime=0;}
+        else if(st.st_mtime!=sfWheel.speedMtime||sfWheel.speed<=0){
+            FILE *f=fopen("/private/var/db/desktop-state/chonkstep/scroll-speed","r");double v=100;
+            if(f){if(fscanf(f,"%lf",&v)!=1)v=100;fclose(f);}
+            sfWheel.speed=v<25?25:v>400?400:v;sfWheel.speedMtime=st.st_mtime;
+        }
+    }
+    return sfWheel.speed;
+}
+
+// (lock held; the timer thread sends too, so the place is the one taken at the last step, not a window looked up)
+static void sfWheelPush(int window,int axis,double points,unsigned bits){
+    struct mach_event event={0};
+    event.windowID=window;event.code=WS_SCROLL_WHEEL;event.x=sfWheel.x;
+    event.y=sfWheel.y;event.mods=currentModifiers|bits;
+    if(axis==WL_POINTER_AXIS_VERTICAL_SCROLL)event.dy=points;else event.dx=points;
+    queuePush(&event);
+}
+
+// ends the gesture after a pause, then runs its momentum, one event a refresh
+static void *sfWheelThread(void *unused){
+    pthread_mutex_lock(&sfWheel.lock);
+    for(;;){
+        uint64_t now=sfMonoNs();
+        if(sfWheel.active&&now>=sfWheel.endAt){
+            // the speed of the last 150 ms of the gesture: the points of the steps after the first of them over the
+            // time they took; a gesture of fewer than three steps there (slow scrolling) has no momentum
+            double sum=0;uint64_t first=0;unsigned n=0;
+            for(unsigned i=0;i<8&&i<sfWheel.recent&&i<sfWheel.gestureSteps;i++){unsigned k=(sfWheel.recent-1-i)%8;
+                if(sfWheel.lastNs-sfWheel.recentNs[k]>150000000ull)break;
+                if(first)sum+=sfWheel.recentPts[(k+1)%8];first=sfWheel.recentNs[k];n++;}
+            double span=first&&n>=3?(double)(sfWheel.lastNs-first)/1e9:0;
+            sfWheel.active=0;
+            sfWheelPush(sfWheel.window,sfWheel.axis,0,1u|4u);
+            sfWheel.velocity=span>0.004?sum/span:0;
+            sfWheel.momentum=fabs(sfWheel.velocity)>300;
+            if(getenv("PD_WS_SCROLL_TRACE"))fprintf(stderr,"WSSCROLL end steps=%u velocity=%.0f momentum=%d\n",sfWheel.gestureSteps,sfWheel.velocity,sfWheel.momentum);
+            if(sfWheel.momentum)sfWheelPush(sfWheel.window,sfWheel.axis,sfWheel.velocity/60,1u|8u|2u);
+        }
+        else if(sfWheel.momentum&&!sfWheel.active){
+            // macOS's deceleration is about 0.95 a refresh at 60 Hz
+            sfWheel.velocity*=0.95;
+            if(fabs(sfWheel.velocity)<25){sfWheel.momentum=0;sfWheelPush(sfWheel.window,sfWheel.axis,0,1u|8u|4u);}
+            else sfWheelPush(sfWheel.window,sfWheel.axis,sfWheel.velocity/60,1u|8u);
+        }
+        struct timespec until;uint64_t wait;
+        if(sfWheel.active)wait=sfWheel.endAt>now?sfWheel.endAt-now:0;
+        else if(sfWheel.momentum)wait=16666667ull;
+        else{pthread_cond_wait(&sfWheel.wake,&sfWheel.lock);continue;}
+        clock_gettime(CLOCK_REALTIME,&until);
+        uint64_t ns=(uint64_t)until.tv_nsec+wait;until.tv_sec+=ns/1000000000ull;until.tv_nsec=ns%1000000000ull;
+        pthread_cond_timedwait(&sfWheel.wake,&sfWheel.lock,&until);
+    }
+    return NULL;
+}
+
+// one wheel step (or a part of one) on `axis`, lines as the protocol counts them (value / 10)
+static void sfWheelStep(int axis,double lines){
+    uint64_t now=sfMonoNs();
+    pthread_mutex_lock(&sfWheel.lock);
+    if(!sfWheel.started){pthread_t t;sfWheel.started=1;pthread_create(&t,NULL,sfWheelThread,NULL);pthread_detach(t);}
+    // fingers back on the trackpad stop the momentum
+    if(sfWheel.momentum){sfWheel.momentum=0;sfWheelPush(sfWheel.window,sfWheel.axis,0,1u|8u|4u);}
+    // another window or axis: the gesture before ends there
+    if(sfWheel.active&&(sfWheel.window!=ws.pointerWindowID||sfWheel.axis!=axis)){sfWheel.active=0;sfWheelPush(sfWheel.window,sfWheel.axis,0,1u|4u);}
+    double dt=sfWheel.lastNs?(double)(now-sfWheel.lastNs)/1e9:1;
+    if(!sfWheel.active||dt>0.15)sfWheel.rate=0;
+    else{double r=fabs(lines)/(dt>0.004?dt:0.004);sfWheel.rate=sfWheel.rate>0?0.6*sfWheel.rate+0.4*r:r;}
+    double mmps=sfWheel.rate*SF_STEP_MM,gain=1;
+    if(mmps>100)gain=1+(mmps-100)/300*2.1;
+    if(gain>3.5)gain=3.5;
+    double points=lines*SF_STEP_POINTS*gain*sfWheelSpeed(now)/100;
+    unsigned bits=1u|(sfWheel.active?0u:2u);
+    struct wsWindow *w=windowForID(ws.pointerWindowID);
+    sfWheel.gestureSteps=sfWheel.active?sfWheel.gestureSteps+1:1;
+    // the fingers are taken as lifted after a pause of 2.5 steps at the speed they had (90 to 200 ms)
+    uint64_t pause=sfWheel.active&&dt<0.2?(uint64_t)(dt*2.5e9):200000000ull;
+    if(pause<90000000ull)pause=90000000ull;
+    if(pause>200000000ull)pause=200000000ull;
+    sfWheel.active=1;sfWheel.window=ws.pointerWindowID;sfWheel.axis=axis;sfWheel.lastNs=now;sfWheel.endAt=now+pause;
+    sfWheel.x=lastPointerX;sfWheel.y=w?w->h-lastPointerY:lastPointerY;
+    unsigned k=sfWheel.recent++%8;sfWheel.recentPts[k]=points;sfWheel.recentNs[k]=now;
+    sfWheelPush(sfWheel.window,axis,points,bits);
+    if(getenv("PD_WS_SCROLL_TRACE"))fprintf(stderr,"WSSCROLL step lines=%.2f dt=%.1fms rate=%.1f/s gain=%.2f points=%.1f bits=%u\n",lines,dt*1000,sfWheel.rate,gain,points,bits);
+    pthread_cond_signal(&sfWheel.wake);
+    pthread_mutex_unlock(&sfWheel.lock);
+}
+
 static void pointerAxis(void *data,struct wl_pointer *pointer,uint32_t time,uint32_t axis,wl_fixed_t value){
     if(axis>WL_POINTER_AXIS_HORIZONTAL_SCROLL)return;
+    if(sfAxisSource==WL_POINTER_AXIS_SOURCE_WHEEL&&!sfWheelLines()){noteInput();sfWheelStep(axis,-wl_fixed_to_double(value)/10.0);return;}
     noteInput();struct mach_event event={0};struct wsWindow *window=windowForID(ws.pointerWindowID);
     int precise=sfPreciseScroll()&&sfAxisSource==WL_POINTER_AXIS_SOURCE_FINGER;
     double delta=-wl_fixed_to_double(value)/(precise?1.0:10.0);
