+/* (TERM10, FX-022) The desk takes linux-dmabuf buffers for toplevels only: a popup's or a layer surface's buffer is
+ * read as shared memory, and a dma-buf there was refused ("SHM access failed: NotManaged"), so Firefox's menu panel
+ * (a popup with GPU layers) never appeared. Such windows present through the CPU frames. */
+static int sfGPURoleTakesDmabuf(struct wsWindow *window){
+    uint32_t layer;
+    if(window->popup!=NULL||window->layerSurface!=NULL||window->surfaceRole==WS_ROLE_POPUP||window->surfaceRole==WS_ROLE_LAYER)return 0;
+    if(window->toplevel!=NULL)return 1;
+    // not shown yet: the role its level will give it
+    if(layerForWindowLevel(window->level,&layer))return 0;
+    return !(window->level==kWSPopUpMenuLevel&&!wsStyleWantsServerFrame(window->style));
+}
