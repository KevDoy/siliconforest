+/* Every font file of a directory, through fontconfig's cache of that directory: a font file
+ * added alone is scanned each time (a variable font: every glyph of every named instance, for
+ * its spacing; the fonts Apple's Terminal carries took a second per configuration at each
+ * launch), a directory is scanned once and read back from the cache after that. */
+bool CTRegistryAddDirectory(const char *path) {
+    bool ok;
+
+    CTRegistryLock();
+    ok = FcConfigAppFontAddDir(config(), (const FcChar8 *)path) == FcTrue;
+    if (ok)
+        CTRegistryInvalidateUnlocked();
+    CTRegistryUnlock();
+    return ok;
+}
