+/* The graphics font of each installed face, made once. Finding it is a fontconfig search by name
+ * and a FreeType face opened from the file (or the whole file read when the search lands on
+ * another face): 0.1 ms to several ms, and Apple's Terminal makes a CTFont for every line it
+ * draws (CTLineCreateWithAttributedString), so a screenful paid it a hundred times. A shared
+ * graphics font also keeps Onyx2D's glyph bitmaps (cached by FreeType face) from being rendered
+ * again for each new CTFont. The cache holds one reference to each font for the process's life. */
+static pthread_mutex_t graphicsCacheLock=PTHREAD_MUTEX_INITIALIZER;
+static CFMutableDictionaryRef graphicsCache;
+
+static CGFontRef createGraphicsFont(const CTFontRecord *record);
+
+static CGFontRef copyGraphicsFont(const CTFontRecord *record) {
+   CFStringRef key=CFStringCreateWithFormat(NULL,NULL,CFSTR("%s#%ld"),record->path,record->index);
+   CGFontRef graphics;
+
+   pthread_mutex_lock(&graphicsCacheLock);
+   if(graphicsCache==NULL)
+    graphicsCache=CFDictionaryCreateMutable(NULL,0,&kCFTypeDictionaryKeyCallBacks,NULL);
+   graphics=(CGFontRef)CFDictionaryGetValue(graphicsCache,key);
+   if(graphics==NULL){
+    graphics=createGraphicsFont(record);
+    if(graphics!=NULL)
+     CFDictionarySetValue(graphicsCache,key,graphics);
+   }
+   if(graphics!=NULL)
+    CGFontRetain(graphics);
+   pthread_mutex_unlock(&graphicsCacheLock);
+   CFRelease(key);
+   return graphics;
+}
