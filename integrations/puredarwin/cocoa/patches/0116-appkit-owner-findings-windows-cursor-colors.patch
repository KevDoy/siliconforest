+
+-(void)_pdShowComponentsOf:(NSColor *)color {
+   NSColor *rgb=[color colorUsingColorSpaceName:NSCalibratedRGBColorSpace];
+   if(rgb==nil)
+    return;
+   CGFloat c[3]={[rgb redComponent],[rgb greenComponent],[rgb blueComponent]};
+   for(int i=0;i<3;i++){
+    [[[self contentView] viewWithTag:901+i] setDoubleValue:round(c[i]*255)];
+    [[[self contentView] viewWithTag:911+i] setIntValue:(int)round(c[i]*255)];
+   }
+}
+
+-(void)_pdComponentChanged:sender {
+   CGFloat c[3];
+   NSInteger tag=[sender tag];
+   for(int i=0;i<3;i++){
+    NSControl *control=(tag==911+i) ? sender : [[self contentView] viewWithTag:901+i];
+    c[i]=MIN(MAX([control doubleValue],0),255)/255.0;
+   }
+   [self setColor:[NSColor colorWithCalibratedRed:c[0] green:c[1] blue:c[2] alpha:[self showsAlpha] ? [[self color] alphaComponent] : 1]];
+}
+
+-(void)orderFront:sender {
+   // whether opacity is offered is the application's choice at the time it shows the panel
+   if(_colorPickers!=nil && [_colorPickers count]==0)
+    [self setShowsAlpha:![NSColor ignoresAlpha]];
+   [super orderFront:sender];
+}
+
+@end
