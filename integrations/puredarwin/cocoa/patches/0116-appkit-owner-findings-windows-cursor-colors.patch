+/* ---- the panel built in code (SiliconForest): a colour swatch, a palette, red/green/blue sliders with their
+ * values, the opacity slider and field (shown when the application does not ignore alpha: [NSColor
+ * setIgnoresAlpha:NO], as Terminal's profile colours are). Tags 901..903: the sliders; 911..913: their fields. */
+
+@interface PDColorPaletteView : NSView
+@end
+
+@implementation PDColorPaletteView
+static NSColor *PDPaletteColor(int i) {
+   static const float rgb[16][3]={
+    {1,0,0},{1,0.5,0},{1,0.85,0},{0.2,0.8,0.2},{0,0.75,0.75},{0,0.45,1},{0.35,0.25,0.85},{0.85,0.3,0.75},
+    {0,0,0},{0.2,0.2,0.2},{0.4,0.4,0.4},{0.6,0.6,0.6},{0.75,0.75,0.75},{0.88,0.88,0.88},{0.95,0.95,0.95},{1,1,1}};
+   return [NSColor colorWithCalibratedRed:rgb[i][0] green:rgb[i][1] blue:rgb[i][2] alpha:1];
+}
+-(BOOL)isFlipped { return YES; }
+-(void)drawRect:(NSRect)rect {
+   NSRect b=[self bounds];
+   CGFloat w=b.size.width/8, h=b.size.height/2;
+   for(int i=0;i<16;i++){
+    NSRect cell=NSMakeRect((i%8)*w,(i/8)*h,w,h);
+    [PDPaletteColor(i) set];
+    NSRectFill(NSInsetRect(cell,1,1));
+   }
+}
+-(BOOL)acceptsFirstMouse:(NSEvent *)event { return YES; }
+-(void)mouseDown:(NSEvent *)event {
+   NSPoint p=[self convertPoint:[event locationInWindow] fromView:nil];
+   NSRect b=[self bounds];
+   int col=(int)(p.x/(b.size.width/8)), row=(int)(p.y/(b.size.height/2));
+   if(col<0 || col>7 || row<0 || row>1)
+    return;
+   NSColorPanel *panel=(NSColorPanel *)[self window];
+   [panel setColor:[PDPaletteColor(row*8+col) colorWithAlphaComponent:[panel showsAlpha] ? [[panel color] alphaComponent] : 1]];
+}
+@end
+
+@implementation NSColorPanel (PDInCode)
+
+static NSTextField *PDLabel(NSView *parent, NSRect frame, NSString *text) {
+   NSTextField *label=[[[NSTextField alloc] initWithFrame:frame] autorelease];
+   [label setStringValue:text];
+   [label setBezeled:NO];
+   [label setDrawsBackground:NO];
+   [label setEditable:NO];
+   [label setSelectable:NO];
+   [label setFont:[NSFont systemFontOfSize:11]];
+   [parent addSubview:label];
+   return label;
+}
+
+-(id)_pdInitInCode {
