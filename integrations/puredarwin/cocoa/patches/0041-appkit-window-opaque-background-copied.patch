--- a/src/Frameworks/AppKit/NSWindow.m
+++ b/src/Frameworks/AppKit/NSWindow.m
@@ -356,6 +356,9 @@
    [_contentView setAutoresizingMask:NSViewWidthSizable|NSViewHeightSizable];
 
    _backgroundColor=[[NSColor windowBackgroundColor] copy];
+   // as on macOS a window starts opaque (Terminal makes a window with a translucent profile
+   // clear only when -setOpaque:NO changes that)
+   _isOpaque=YES;
 
    _delegate=nil;
    _firstResponder=self;
--- a/src/Frameworks/AppKit/NSThemeFrame.m
+++ b/src/Frameworks/AppKit/NSThemeFrame.m
@@ -400,7 +400,12 @@
     [[[self window] backgroundColor] getRed:&r green:&g blue:&b alpha:&a];
     O2ContextSetRGBStrokeColor(_context, r, g, b, a);
     O2ContextSetRGBFillColor(_context, r, g, b, a);
+    // copied, as AppKit fills a window's background: a translucent colour (Terminal's windows are
+    // clear) drawn over what the backing store held before would stack up with every redraw
+    O2ContextSaveGState(_context);
+    O2ContextSetBlendMode(_context, kO2BlendModeCopy);
     O2ContextFillRect(_context, bounds);
+    O2ContextRestoreGState(_context);
 
     if([[self window] styleMask] == NSBorderlessWindowMask || ([[self window] styleMask] & NSFullScreenWindowMask))
         return;
