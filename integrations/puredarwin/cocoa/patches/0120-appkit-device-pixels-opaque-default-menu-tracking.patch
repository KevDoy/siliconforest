+ * pixels per point along each axis (the window's base CTM), from the store's corner. An edge within a millionth of a pixel of a boundary
+ * is on it, and nearest rounds halves up whichever edge it is, so the bottom of one rectangle and
+ * the top of the next, computed differently, come to the same pixel: at 150 % a terminal's rows of
+ * whole points (whole points were all the old -centerScanRect: aligned to) each ended half way
+ * through a pixel that the next row covered again. */
+static CGFloat pdAlignEdge(CGFloat v,BOOL isMin,NSUInteger bits){
+   const CGFloat e=1e-6;
+
+   if(bits&4)
+    return floor(v+0.5+e);
+   if(bits&1)
+    return isMin ? ceil(v-e) : floor(v+e);
+   if(bits&2)
+    return isMin ? floor(v+e) : ceil(v-e);
+   return v;
+}
+
+// one axis in pixels: bits of its min edge, max edge and size, each 1 inward, 2 outward, 4 nearest
+static void pdAlignAxis(CGFloat *lo,CGFloat *hi,NSUInteger minBits,NSUInteger maxBits,NSUInteger sizeBits){
+   const CGFloat e=1e-6;
+   CGFloat a=*lo,b=*hi,size=b-a;
+
+   if(sizeBits&4)
+    size=floor(size+0.5+e);
+   else if(sizeBits&1)
+    size=floor(size+e);
+   else if(sizeBits&2)
+    size=ceil(size-e);
+   if(minBits)
+    a=pdAlignEdge(a,YES,minBits);
+   if(maxBits)
+    b=pdAlignEdge(b,NO,maxBits);
+   if(sizeBits && minBits && !maxBits)
+    b=a+size;
+   else if(sizeBits && maxBits && !minBits)
+    a=b-size;
+   if(b<a)
+    b=a;
+   *lo=a;
+   *hi=b;
+}
