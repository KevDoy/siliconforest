+// the window server tells the compositor that an opaque window covers what is behind it everywhere
+static void pdSendOpaque(NSWindow *self,BOOL value){
+   struct wsRPCSimple data = {
+       { kWSWindowSetOpaque, sizeof(struct wsRPCSimple) - sizeof(struct wsRPCBase) },
+       (int)[self windowNumber], value ? 1 : 0
+   };
+
+   _windowServerRPC(&data, sizeof(data), NULL, NULL);
+}
