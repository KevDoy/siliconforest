+// libWindowServer: whether the compositor blurs behind translucent windows (weak: an older library has no answer)
+extern int _windowServerCanBlurBehind(void) __attribute__((weak_import));
+
+/* macOS draws a translucent window (Terminal's default profile, a sidebar, a popover) over a blur of
+ * what is behind it. A compositor that cannot blur would show what is behind sharp, as if the window had a
+ * hole: there transparency is reduced, as macOS reduces it when the user asks (Accessibility > Display),
+ * and applications draw their windows opaque. The user's own setting decides when there is one:
+ * `defaults write com.apple.universalaccess reduceTransparency -bool false` gives translucency back. */
 - (BOOL)accessibilityDisplayShouldReduceTransparency
 {
-    return [self _universalAccessFlag:@"reduceTransparency"];
+    id value = [(id)CFPreferencesCopyAppValue(CFSTR("reduceTransparency"), CFSTR("com.apple.universalaccess")) autorelease];
+
+    if ([value respondsToSelector:@selector(boolValue)])
+        return [value boolValue];
+    return _windowServerCanBlurBehind == NULL || !_windowServerCanBlurBehind();
 }
 
