+/* Device pixels per point of the backing store along each axis, the factors of its base CTM
+ * (-createCGContextIfNeeded): the store is whole pixels, wsPixelsForPoints() of the frame's size */
+-(NSSize)_backingPixelsPerPoint {
+   int scale120=_backingScale120>0 ? _backingScale120 : _windowServerBackingScale120();
+   CGFloat s=scale120/120.0;
+
+   if(scale120==120 || _frame.size.width<1 || _frame.size.height<1)
+    return NSMakeSize(s,s);
+   return NSMakeSize(wsPixelsForPoints(_frame.size.width,scale120)/floor(_frame.size.width),
+                     wsPixelsForPoints(_frame.size.height,scale120)/floor(_frame.size.height));
+}
+
+-(NSRect)backingAlignedRect:(NSRect)rect options:(NSAlignmentOptions)options {
+   NSSize pixels=[self _backingPixelsPerPoint];
+
+   return _NSBackingAlignedWindowRect(rect,pixels.width,pixels.height,options,NO);
+}
