 static void displayLinkCall(CVDisplayLink *link, CVTimeStamp *now, CVTimeStamp *out) {
     CVOptionFlags flagsOut = 0;
+    // (TERM11) PD_CV_TRACE=1: every tick, the time it stands for and when it ran (ms, host clock)
+    static int trace = -1;
+    if (trace < 0)
+        trace = getenv("PD_CV_TRACE") != NULL;
+    if (trace) {
+        static mach_timebase_info_data_t tb;
+        if (tb.denom == 0)
+            mach_timebase_info(&tb);
+        // to a file of this process in the directory PD_CV_TRACE names (Firefox's GPU process has no stderr)
+        static FILE *traceFile;
+        if (traceFile == NULL) {
+            char path[512];
