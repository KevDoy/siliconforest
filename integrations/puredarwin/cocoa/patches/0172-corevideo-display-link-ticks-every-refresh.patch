+            traceFile = fopen(path, "a");
+            if (traceFile == NULL)
+                traceFile = stderr;
+        }
+        fprintf(traceFile, "CVTICK at=%.2f ran=%.2f \n", now->hostTime * (double)tb.numer / tb.denom / 1e6,
