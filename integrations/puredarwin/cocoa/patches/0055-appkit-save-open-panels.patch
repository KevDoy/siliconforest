+/* SPDX-License-Identifier: MIT
+ *
+ * The save and open panels' contents, drawn by AppKit.
+ *
+ * NSSavePanel and NSOpenPanel handed their work to the display (NSDisplay -savePanel:...), which
+ * on Windows showed the system's dialog; here there is no such dialog and the methods were not
+ * implemented, so Terminal's Export Text As, Export Settings and Open did nothing. The panel is
+ * its own window: a name field (saving), the folder it is in with its parent reachable, the
+ * folder's items (folders first, a double click opens a folder or chooses a file), the
+ * application's accessory view, Cancel and the default button (Return; Escape cancels).
+ * -beginSheetModalForWindow:completionHandler: runs the panel modally and then calls the handler,
+ * as the sheet's end would.
+ */
+#import <AppKit/NSSavePanel.h>
+#import <AppKit/NSOpenPanel.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSTextField.h>
+#import <AppKit/NSButton.h>
+#import <AppKit/NSScrollView.h>
+#import <AppKit/NSClipView.h>
+#import <AppKit/NSColor.h>
+#import <AppKit/NSFont.h>
+#import <AppKit/NSEvent.h>
+#import <AppKit/NSGraphics.h>
+#import <AppKit/NSStringDrawing.h>
+#import <AppKit/NSAttributedString.h>
+#import <Foundation/Foundation.h>
+#include <objc/runtime.h>
+
+@interface NSSavePanel (PDFilePanelPrivate)
+- (void)_setFilename:(NSString *)filename;
+@end
+
+@interface PDFileList : NSView {
+@public
+    NSArray *_entries;      // names; a name ending in "/" is a folder
+    NSInteger _selected;
+    NSSavePanel *_panel;    // not retained
+}
+@end
+
+@interface NSSavePanel (PDFilePanel)
+- (void)_pdListChoose:(NSInteger)row;
+- (void)_pdListSelect:(NSInteger)row;
+@end
+
+static const CGFloat PDRow = 20;
+
+@implementation PDFileList
+
+- (BOOL)isFlipped { return YES; }
+- (BOOL)acceptsFirstResponder { return YES; }
+- (void)dealloc { [_entries release]; [super dealloc]; }
+
+- (void)drawRect:(NSRect)rect
+{
+    NSDictionary *plain = @{ NSFontAttributeName: [NSFont systemFontOfSize:13], NSForegroundColorAttributeName: [NSColor textColor] };
+    NSDictionary *chosen = @{ NSFontAttributeName: [NSFont systemFontOfSize:13], NSForegroundColorAttributeName: [NSColor alternateSelectedControlTextColor] };
+
+    [[NSColor textBackgroundColor] setFill];
+    NSRectFill(rect);
+    for (NSUInteger i = 0; i < [_entries count]; i++) {
+        NSRect row = NSMakeRect(0, i * PDRow, NSWidth([self bounds]), PDRow);
+        NSString *name = [_entries objectAtIndex:i];
+        BOOL folder = [name hasSuffix:@"/"];
+
+        if (!NSIntersectsRect(row, rect))
+            continue;
+        if ((NSInteger)i == _selected) {
+            [[NSColor alternateSelectedControlColor] setFill];
+            NSRectFill(row);
+        }
+        if (folder)
+            name = [[name substringToIndex:[name length] - 1] stringByAppendingString:@"  ▸"];
+        [name drawAtPoint:NSMakePoint(8, NSMinY(row) + 2) withAttributes:(NSInteger)i == _selected ? chosen : plain];
+    }
+}
+
+- (void)_pdScrollToSelection
+{
+    if (_selected >= 0)
+        [self scrollRectToVisible:NSMakeRect(0, _selected * PDRow, 1, PDRow)];
+}
+
+- (void)mouseDown:(NSEvent *)event
+{
+    NSPoint at = [self convertPoint:[event locationInWindow] fromView:nil];
+    NSInteger row = (NSInteger)(at.y / PDRow);
+
+    if (row < 0 || row >= (NSInteger)[_entries count])
+        return;
+    _selected = row;
+    [self setNeedsDisplay:YES];
+    [_panel _pdListSelect:row];
+    if ([event clickCount] >= 2)
+        [_panel _pdListChoose:row];
+}
+
+- (void)keyDown:(NSEvent *)event
+{
+    NSString *chars = [event charactersIgnoringModifiers];
+    unichar c = [chars length] ? [chars characterAtIndex:0] : 0;
+    NSInteger count = (NSInteger)[_entries count];
+
+    if (c == NSUpArrowFunctionKey || c == NSDownArrowFunctionKey) {
+        if (count == 0)
+            return;
+        _selected = c == NSUpArrowFunctionKey ? MAX(0, _selected - 1) : MIN(count - 1, _selected + 1);
+        [self setNeedsDisplay:YES];
+        [self _pdScrollToSelection];
+        [_panel _pdListSelect:_selected];
+    }
+    else if (c == NSRightArrowFunctionKey && _selected >= 0 && [[_entries objectAtIndex:_selected] hasSuffix:@"/"])
+        [_panel _pdListChoose:_selected];
+    else if (c == NSLeftArrowFunctionKey && count > 0 && [[_entries objectAtIndex:0] isEqualToString:@"../"])
+        [_panel _pdListChoose:0];
+    else
+        [super keyDown:event];
+}
+
+@end
+
+static char PDListKey, PDNameKey, PDWhereKey, PDOKKey, PDNameValueKey, PDDirectoryKey, PDTypesKey;
+
+@implementation NSSavePanel (PDFilePanel)
+
+- (BOOL)_pdIsOpen { return [self isKindOfClass:[NSOpenPanel class]]; }
+
+- (NSString *)_pdDirectory
+{
+    NSString *d = objc_getAssociatedObject(self, &PDDirectoryKey);
+
+    if ([d length] == 0)
+        d = [self directory];
+    if ([d length] == 0)
+        d = NSHomeDirectory();
+    return [d stringByStandardizingPath];
+}
+
+- (void)_pdSetDirectory:(NSString *)directory
+{
+    objc_setAssociatedObject(self, &PDDirectoryKey, [directory stringByStandardizingPath], OBJC_ASSOCIATION_COPY);
+    [self setDirectory:[directory stringByStandardizingPath]];
+}
+
+// the folder's items: "../" first unless at the root, folders, then files, each sorted by name
+- (void)_pdLoad
+{
+    PDFileList *list = objc_getAssociatedObject(self, &PDListKey);
+    NSString *dir = [self _pdDirectory];
+    NSMutableArray *folders = [NSMutableArray array], *files = [NSMutableArray array];
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSArray *types = objc_getAssociatedObject(self, &PDTypesKey);
+    BOOL open = [self _pdIsOpen];
+
+    for (NSString *name in [fm contentsOfDirectoryAtPath:dir error:NULL]) {
+        BOOL isDir = NO;
+
+        if ([name hasPrefix:@"."])
+            continue;
+        if (![fm fileExistsAtPath:[dir stringByAppendingPathComponent:name] isDirectory:&isDir])
+            continue;
+        if (isDir && ![[name pathExtension] isEqualToString:@"app"])
+            [folders addObject:[name stringByAppendingString:@"/"]];
+        else if (!open || [types count] == 0 || [types containsObject:[name pathExtension]])
+            [files addObject:name];
+    }
+    [folders sortUsingSelector:@selector(caseInsensitiveCompare:)];
+    [files sortUsingSelector:@selector(caseInsensitiveCompare:)];
+    NSMutableArray *all = [NSMutableArray array];
+    if (![dir isEqualToString:@"/"])
+        [all addObject:@"../"];
+    [all addObjectsFromArray:folders];
+    [all addObjectsFromArray:files];
+    [list->_entries release];
+    list->_entries = [all copy];
+    list->_selected = -1;
+    [list setFrameSize:NSMakeSize(NSWidth([[list superview] bounds]), MAX(NSHeight([[list superview] bounds]), [all count] * PDRow))];
+    [list setNeedsDisplay:YES];
+    [list scrollPoint:NSZeroPoint];
+    [(NSTextField *)objc_getAssociatedObject(self, &PDWhereKey) setStringValue:dir];
+}
+
+- (void)_pdListSelect:(NSInteger)row
+{
+    PDFileList *list = objc_getAssociatedObject(self, &PDListKey);
+    NSString *name = [list->_entries objectAtIndex:row];
+
+    if (![self _pdIsOpen] && ![name hasSuffix:@"/"])
+        [(NSTextField *)objc_getAssociatedObject(self, &PDNameKey) setStringValue:name];
+}
+
+- (void)_pdListChoose:(NSInteger)row
+{
+    PDFileList *list = objc_getAssociatedObject(self, &PDListKey);
+    NSString *name = [list->_entries objectAtIndex:row];
+
+    if ([name hasSuffix:@"/"]) {
+        NSString *dir = [name isEqualToString:@"../"] ? [[self _pdDirectory] stringByDeletingLastPathComponent]
+                                                      : [[self _pdDirectory] stringByAppendingPathComponent:[name substringToIndex:[name length] - 1]];
+        [self _pdSetDirectory:dir];
+        [self _pdLoad];
+        return;
+    }
+    [self _pdOK:nil];
+}
+
+- (void)_pdCancel:(id)sender
+{
+    [NSApp stopModalWithCode:NSFileHandlingPanelCancelButton];
+}
+
+- (void)_pdOK:(id)sender
+{
+    PDFileList *list = objc_getAssociatedObject(self, &PDListKey);
+    NSString *dir = [self _pdDirectory];
+
+    if ([self _pdIsOpen]) {
+        NSInteger row = list->_selected;
+        NSString *name = row >= 0 ? [list->_entries objectAtIndex:row] : nil;
+        BOOL folder = [name hasSuffix:@"/"];
+        NSOpenPanel *open = (NSOpenPanel *)self;
+
+        if (name == nil && [open canChooseDirectories])
+            name = @"", folder = YES;
+        if (name == nil || (folder && ![open canChooseDirectories]) || (!folder && ![open canChooseFiles])) {
+            if (folder && name != nil)
+                [self _pdListChoose:row];
+            else
+                NSBeep();
+            return;
+        }
+        NSString *path = [name isEqualToString:@"../"] ? [dir stringByDeletingLastPathComponent]
+                         : [dir stringByAppendingPathComponent:folder ? [name stringByTrimmingCharactersInSet:[NSCharacterSet characterSetWithCharactersInString:@"/"]] : name];
+        [self _setFilename:path];
+        [self _pdSetFilenames:@[ path ]];
+    }
+    else {
+        NSString *name = [(NSTextField *)objc_getAssociatedObject(self, &PDNameKey) stringValue];
+        NSArray *types = objc_getAssociatedObject(self, &PDTypesKey);
+
+        if ([name length] == 0) {
+            NSBeep();
+            return;
+        }
+        if ([types count] > 0 && ![types containsObject:[name pathExtension]])
+            name = [name stringByAppendingPathExtension:[types objectAtIndex:0]];
+        objc_setAssociatedObject(self, &PDNameValueKey, name, OBJC_ASSOCIATION_COPY);
+        [self _setFilename:[dir stringByAppendingPathComponent:name]];
+    }
+    [NSApp stopModalWithCode:NSFileHandlingPanelOKButton];
+}
+
+- (void)_pdSetFilenames:(NSArray *)paths
+{
+    if ([self isKindOfClass:[NSOpenPanel class]]) {
+        Ivar ivar = class_getInstanceVariable([NSOpenPanel class], "_filenames");
+        NSArray **slot = (NSArray **)((char *)self + ivar_getOffset(ivar));
+
+        [*slot release];
+        *slot = [paths copy];
+    }
+}
+
+static NSTextField *pdLabel(NSString *text, NSRect frame)
+{
+    NSTextField *label = [[[NSTextField alloc] initWithFrame:frame] autorelease];
+
+    [label setStringValue:text];
+    [label setEditable:NO];
+    [label setSelectable:NO];
+    [label setBezeled:NO];
+    [label setDrawsBackground:NO];
+    [label setAlignment:NSRightTextAlignment];
+    return label;
+}
+
+// lays the panel out afresh each time it runs (the accessory view may have changed)
+- (void)_pdBuild
+{
+    BOOL open = [self _pdIsOpen];
+    NSView *accessory = [self accessoryView];
+    CGFloat width = 560, listHeight = 260, accessoryHeight = accessory ? NSHeight([accessory frame]) + 12 : 0;
+    CGFloat height = 20 + (open ? 0 : 34) + 28 + listHeight + accessoryHeight + 56;
+    NSView *content = [[[NSView alloc] initWithFrame:NSMakeRect(0, 0, width, height)] autorelease];
+    CGFloat y = height - 20;
+
+    if (!open) {
+        y -= 24;
+        NSString *label = objc_getAssociatedObject(self, @selector(nameFieldLabel)) ?: @"Save As:";
+        [content addSubview:pdLabel(label, NSMakeRect(10, y + 2, 90, 20))];
+        NSTextField *name = [[[NSTextField alloc] initWithFrame:NSMakeRect(108, y, width - 128, 24)] autorelease];
+        [name setStringValue:objc_getAssociatedObject(self, &PDNameValueKey) ?: ([[self filename] lastPathComponent] ?: @"")];
+        [name setTarget:self];
+        [name setAction:@selector(_pdOK:)];
+        [content addSubview:name];
+        objc_setAssociatedObject(self, &PDNameKey, name, OBJC_ASSOCIATION_RETAIN);
+        y -= 10;
+    }
+    y -= 24;
+    [content addSubview:pdLabel(@"Where:", NSMakeRect(10, y + 2, 90, 20))];
+    NSTextField *where = pdLabel(@"", NSMakeRect(108, y + 2, width - 128, 20));
+    [where setAlignment:NSLeftTextAlignment];
+    [where setSelectable:YES];
+    [content addSubview:where];
+    objc_setAssociatedObject(self, &PDWhereKey, where, OBJC_ASSOCIATION_RETAIN);
+    y -= 6 + listHeight;
+
+    NSScrollView *scroll = [[[NSScrollView alloc] initWithFrame:NSMakeRect(20, y, width - 40, listHeight)] autorelease];
+    [scroll setHasVerticalScroller:YES];
+    [scroll setBorderType:NSBezelBorder];
+    PDFileList *list = [[[PDFileList alloc] initWithFrame:NSMakeRect(0, 0, NSWidth([[scroll contentView] bounds]), listHeight)] autorelease];
+    list->_panel = self;
+    list->_selected = -1;
+    [scroll setDocumentView:list];
+    [content addSubview:scroll];
+    objc_setAssociatedObject(self, &PDListKey, list, OBJC_ASSOCIATION_RETAIN);
+
+    if (accessory != nil) {
+        y -= accessoryHeight;
+        [accessory setFrameOrigin:NSMakePoint(floor((width - NSWidth([accessory frame])) / 2), y + 6)];
+        [content addSubview:accessory];
+    }
+    NSString *prompt = [self prompt];
+    if ([prompt length] == 0)
+        prompt = open ? @"Open" : @"Save";
+    NSButton *ok = [[[NSButton alloc] initWithFrame:NSMakeRect(width - 120, 14, 100, 30)] autorelease];
+    [ok setTitle:prompt];
+    [ok setBezelStyle:NSRoundedBezelStyle];
+    [ok setKeyEquivalent:@"\r"];
+    [ok setTarget:self];
+    [ok setAction:@selector(_pdOK:)];
+    [content addSubview:ok];
+    objc_setAssociatedObject(self, &PDOKKey, ok, OBJC_ASSOCIATION_RETAIN);
+    NSButton *cancel = [[[NSButton alloc] initWithFrame:NSMakeRect(width - 228, 14, 100, 30)] autorelease];
+    [cancel setTitle:@"Cancel"];
+    [cancel setBezelStyle:NSRoundedBezelStyle];
+    [cancel setKeyEquivalent:@"\033"];
+    [cancel setTarget:self];
+    [cancel setAction:@selector(_pdCancel:)];
+    [content addSubview:cancel];
+
+    [self setContentView:content];
+    [self setContentSize:NSMakeSize(width, height)];
+    [super setTitle:[self _pdTitle]];
+    [self _pdLoad];
+    [self center];
+    if (!open)
+        [self makeFirstResponder:objc_getAssociatedObject(self, &PDNameKey)];
+    else
+        [self makeFirstResponder:list];
+}
+
+- (NSString *)_pdTitle
+{
+    Ivar ivar = class_getInstanceVariable([NSSavePanel class], "_dialogTitle");
+    NSString *title = ivar ? object_getIvar(self, ivar) : nil;
+
+    return [title length] ? title : ([self _pdIsOpen] ? @"Open" : @"Save");
+}
+
+- (NSInteger)_pdRun
+{
+    [self _pdBuild];
+    [self makeKeyAndOrderFront:nil];
+    NSInteger result = [NSApp runModalForWindow:self];
+    [self orderOut:nil];
+    // the accessory view goes back to the application with the panel
+    [[self accessoryView] removeFromSuperview];
+    return result;
+}
+
+@end
+
+/* The panels' API, macOS's names; the old -runModalForDirectory: forms land here too. */
+@implementation NSSavePanel (PDFilePanelAPI)
+
+- (void)setNameFieldStringValue:(NSString *)value { objc_setAssociatedObject(self, &PDNameValueKey, value, OBJC_ASSOCIATION_COPY); }
+- (NSString *)nameFieldStringValue { return objc_getAssociatedObject(self, &PDNameValueKey) ?: [[self filename] lastPathComponent]; }
+- (void)setNameFieldLabel:(NSString *)value { objc_setAssociatedObject(self, @selector(nameFieldLabel), value, OBJC_ASSOCIATION_COPY); }
+- (NSString *)nameFieldLabel { return objc_getAssociatedObject(self, @selector(nameFieldLabel)) ?: @"Save As:"; }
+- (void)setDirectoryURL:(NSURL *)url { if ([url isFileURL]) [self _pdSetDirectory:[url path]]; }
+- (NSURL *)directoryURL { return [NSURL fileURLWithPath:[self _pdDirectory] isDirectory:YES]; }
+- (void)setAllowedFileTypes:(NSArray *)types { objc_setAssociatedObject(self, &PDTypesKey, types, OBJC_ASSOCIATION_COPY); }
+- (NSArray *)allowedFileTypes { return objc_getAssociatedObject(self, &PDTypesKey); }
+- (void)setAllowsOtherFileTypes:(BOOL)value { }
+- (BOOL)allowsOtherFileTypes { return NO; }
+- (void)setCanCreateDirectories:(BOOL)value { }
+- (BOOL)canCreateDirectories { return NO; }
+- (void)setExtensionHidden:(BOOL)value { }
+- (BOOL)isExtensionHidden { return NO; }
+- (void)setCanSelectHiddenExtension:(BOOL)value { }
+- (void)setShowsHiddenFiles:(BOOL)value { }
+- (void)setShowsTagField:(BOOL)value { }
+- (void)setTagNames:(NSArray *)value { }
+
+- (NSInteger)runModal { return [self _pdRun]; }
+
+- (int)runModalForDirectory:(NSString *)directory file:(NSString *)file
+{
+    if ([directory length])
+        [self _pdSetDirectory:directory];
+    if ([file length])
+        [self setNameFieldStringValue:file];
+    return (int)[self _pdRun];
+}
+
+- (void)beginSheetModalForWindow:(NSWindow *)window completionHandler:(void (^)(NSInteger result))handler
+{
+    NSInteger result = [self _pdRun];
+
+    if (handler)
+        handler(result);
+}
+
+- (void)beginWithCompletionHandler:(void (^)(NSInteger result))handler
+{
+    [self beginSheetModalForWindow:nil completionHandler:handler];
+}
+
+@end
+
+@implementation NSOpenPanel (PDFilePanelAPI)
+
+- (NSInteger)runModal { return [self _pdRun]; }
+
+- (int)runModalForDirectory:(NSString *)directory file:(NSString *)file types:(NSArray *)types
+{
+    if ([directory length])
+        [self _pdSetDirectory:directory];
+    [self setAllowedFileTypes:types];
+    return (int)[self _pdRun];
+}
+
+- (int)runModalForTypes:(NSArray *)types
+{
+    return [self runModalForDirectory:nil file:nil types:types];
+}
+
+@end
