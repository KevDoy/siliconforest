+struct PDSelectionWrite { NSData *data; int fd; };
+
+static void *PDSelectionWriter(void *arg) {
+   struct PDSelectionWrite *write=arg;
+
+   PDWriteAll(write->fd,write->data);
+   [write->data release];
+   free(write);
+   return NULL;
+}
+
+// a uri-list line for a URL, else the data as offered
+static NSData *PDSelectionBytes(NSString *mimeType,NSData *data) {
+   if(data!=nil && [mimeType isEqualToString:@"text/uri-list"]){
+    NSString *url=[[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease];
+    if(url!=nil && ![url hasSuffix:@"\n"])
+     data=[[url stringByAppendingString:@"\r\n"] dataUsingEncoding:NSUTF8StringEncoding];
+   }
+   return data;
+}
