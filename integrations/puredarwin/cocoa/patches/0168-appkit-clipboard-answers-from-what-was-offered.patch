+// (TERM11) the data this process offered for a type: the board's own while it still holds that offer (a lazy owner is
+// asked here), else the copy taken when it was offered - never another client's selection
+-(NSData *)_pdOfferedDataForType:(NSString *)type {
+   NSData *data=nil;
+
+   type=PDCanonicalType(type);
+   if(!_systemBacked && _changeCount==publishedChangeCount){
+    data=[_items objectForKey:type];
+    if(data==nil && _owner!=nil && [_owner respondsToSelector:@selector(pasteboard:provideDataForType:)]){
+     [_owner pasteboard:self provideDataForType:PDLegacyType(type)!=nil && ![_types containsObject:type]?PDLegacyType(type):type];
+     data=[_items objectForKey:type];
+    }
+   }
+   if(data==nil){
+    pthread_mutex_lock(&publishedLock);
+    data=[[[publishedItems objectForKey:type] retain] autorelease];
+    pthread_mutex_unlock(&publishedLock);
+   }
+   return data;
+}
