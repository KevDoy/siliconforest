+// the bar opens the menu of a title; the keyboard goes to the menu's first item when asked
+- (NSMenuView *)_pdBarOpenIndex:(NSInteger)index selectFirst:(BOOL)first
+{
+    [self closeSubmenu];
+    [self setHighlightedItemIndex:index];
+    // the title is lit before its menu is built and drawn
+    [[self window] displayIfNeeded];
+    if (![self _pdItemOpensAtIndex:index])
+        return self;
+    [self openSubmenuAtIndex:index];
+    if (_submenuView == nil)
+        return self;
+    if (first)
+        [_submenuView setHighlightedItemIndex:[_submenuView _pdLiveIndexFrom:0 step:1]];
+    return _submenuView;
+}
+
+// the next title of the bar that can be opened, going round
+- (NSInteger)_pdBarIndexFrom:(NSInteger)from step:(NSInteger)step
+{
+    NSInteger count = (NSInteger)[[self presentedItems] count], i, at = from;
+
+    for (i = 0; i < count; i++) {
+        at = (at + step + count) % count;
+        if ([self _pdItemOpensAtIndex:at])
+            return at;
+    }
+    return from;
+}
+
+/* The keyboard's way into a window's menu strip (Control-F2, as macOS moves the focus to the menu
+ * bar): the first menu opens with its first item lit; the arrows go on from there. */
+- (void)_pdTrackFromKeyEvent:(NSEvent *)event
+{
+    NSMenuItem *chosen;
+
+    if (_menu == nil || _tracking || !_horizontal)
+        return;
+    chosen = [self _trackFromEvent:event];
+    if (chosen != nil && [chosen action] != NULL)
+        [NSApp sendAction:[chosen action] to:[chosen target] from:chosen];
+}
