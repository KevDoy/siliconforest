+- (BOOL)_isDark;
+@end
+
+@interface PDMenuStripView : NSMenuView {
+    NSString *_shownTitles;
+}
+- (void)_pdRefresh;
+@end
+
+@interface NSMenuView (PDSizes)
+- (void)_pdForgetSizes;
+@end
+
+@implementation PDMenuStripView
+
+- (void)dealloc
+{
+    [_shownTitles release];
+    [super dealloc];
+}
+
+/* The first item of a main menu is the application menu. macOS shows it under the application's
+ * name whatever title the item carries (nibs carry placeholders). */
+- (NSString *)_pdTitleOfItem:(NSMenuItem *)item
+{
+    NSArray *items = [[self menu] itemArray];
+
+    if ([items count] > 0 && item == [items objectAtIndex:0] && [item hasSubmenu]) {
+        NSBundle *bundle = [NSBundle mainBundle];
+        NSString *name = [bundle objectForInfoDictionaryKey:@"CFBundleDisplayName"];
+
+        if (![name isKindOfClass:[NSString class]] || [name length] == 0)
+            name = [bundle objectForInfoDictionaryKey:@"CFBundleName"];
+        if (![name isKindOfClass:[NSString class]] || [name length] == 0)
+            name = [[NSProcessInfo processInfo] processName];
+        return name;
+    }
+    return [item title];
+}
+
+- (NSString *)_titles
+{
+    NSMutableString *all = [NSMutableString string];
+
+    for (NSMenuItem *item in [self presentedItems])
+        [all appendFormat:@"%@%c\n", [self _pdTitleOfItem:item], [item isEnabled] ? '+' : '-'];
+    return all;
+}
+
+// the titles are drawn again when one of them changed (an application may fill its menu in late)
+- (void)_pdRefresh
+{
+    NSString *now = [self _titles];
+
+    if (_shownTitles == nil || ![now isEqualToString:_shownTitles]) {
+        [_shownTitles release];
+        _shownTitles = [now copy];
+        [self _pdForgetSizes];
+        if (getenv("PD_MENU_TRACE") != NULL)
+            NSLog(@"menu strip titles: %@", [[self presentedItems] valueForKey:@"title"]);
+        [self setNeedsDisplay:YES];
+    }
+}
+
+- (BOOL)isOpaque
+{
+    return YES;
+}
+
+- (void)drawRect:(NSRect)rect
+{
+    BOOL dark = [[NSAppearance currentDrawingAppearance] _isDark];
+    NSRect bounds = [self bounds];
+
+    // the window's own ground rather than a bar of another look
+    [(dark ? [NSColor colorWithCalibratedWhite:0.16 alpha:1] : [NSColor colorWithCalibratedWhite:0.955 alpha:1]) setFill];
+    NSRectFill(rect);
+    _pdBarGroundDrawn = YES;
+    [super drawRect:rect];
+    _pdBarGroundDrawn = NO;
+    // a hairline between the strip and what lies under it
+    [[NSColor colorWithCalibratedWhite:dark ? 0.0 : 0.0 alpha:dark ? 0.5 : 0.14] setFill];
+    NSRectFillUsingOperation(NSMakeRect(0, NSMaxY(bounds) - 1, NSWidth(bounds), 1), NSCompositeSourceOver);
+}
+
+- (BOOL)acceptsFirstMouse:(NSEvent *)event
+{
+    return YES;
+}
+
+@end
