+/* (TERM11, FX-022) A view that has a layer and moves under another view: its layer goes into the superview's layer (and
+ * renders with it) when that one has a layer, else the view renders it with a context of its own. Its layer stayed
+ * where it was: Firefox's popup puts its ChildView (with the layers its pixels are in) under a layer-backed content
+ * view, whose layer then had no sublayers - the menu panel was read back empty, a transparent window. */
+-(void)_pdPlaceLayerUnderSuperview {
+   if(_layer==nil || isSurfaceLayer(_layer))
+    return;
+   if([_superview layer]!=nil){
+    if([_layer superlayer]!=[_superview layer]){
+     [_layerContext invalidate];
+     [_layerContext release];
+     _layerContext=nil;
+     [_layer removeFromSuperlayer];
+     [[_superview layer] addSublayer:_layer];
+    }
+   }
+   else {
+    [_layer removeFromSuperlayer];
+    [self _createLayerContextIfNeeded];
+   }
+}
+
+// (TERM11) before a tree is rendered: a layer of a view below that lies outside it (an order of calls the rules above
+// do not cover) is put back where the views say it belongs
+-(void)_pdAdoptLayersOfSubviews {
+   for(NSView *view in _subviews){
+    CALayer *layer=[view layer];
+
+    if(layer!=nil && !isSurfaceLayer(layer) && _layer!=nil && [layer superlayer]!=_layer){
+     if(getenv("PD_WIN_TRACE")!=NULL)
+      fprintf(stderr,"PDWIN adopting the layer %p of %s under %s\n",(void *)layer,object_getClassName(view),object_getClassName(self));
+     [view _pdPlaceLayerUnderSuperview];
+    }
+    if(layer!=nil)
+     [view _pdAdoptLayersOfSubviews];
+   }
+}
