+/* (TERM9) The display's clock as the compositor tells it (wp_presentation): each commit of a frame asks for the
+ * flip that showed it; the latest flip time (in mach_absolute_time), the measured refresh, a counter that moves
+ * at each new flip and the number of commits still waiting for theirs are kept for CoreVideo's display link,
+ * which ticks from them instead of a free-running timer (one clock: the display's). */
+static struct {
+    pthread_mutex_t lock;
+    pthread_cond_t moved;
+    uint64_t counter;        // flips seen (one per flip, whatever the number of our surfaces in it)
+    uint64_t flipSeq;        // the compositor's sequence of the latest flip
+    uint64_t presentedHost;  // that flip in mach_absolute_time units
+    uint64_t refreshNs;
+    int pending;             // commits asked about whose answer has not come
+    uint64_t pendingSince;   // host time of the oldest of them
+} wsClock = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER };
+
+static double wsNowMs(void);
+
+static uint64_t wsNsToHost(uint64_t ns) {
+    static mach_timebase_info_data_t tb;
+    if (tb.denom == 0) mach_timebase_info(&tb);
+    return (uint64_t)((__uint128_t)ns * tb.denom / tb.numer);
+}
+
+static uint64_t wsHostToNs(uint64_t host) {
+    static mach_timebase_info_data_t tb;
+    if (tb.denom == 0) mach_timebase_info(&tb);
+    return (uint64_t)((__uint128_t)host * tb.numer / tb.denom);
+}
+
+static void presentationClockId(void *data, struct wp_presentation *presentation, uint32_t clk) {
+    struct timespec t;
+    // the compositor runs on this machine: its clock is one this process can read
+    ws.presentationClock = clock_gettime((clockid_t)clk, &t) == 0 ? (clockid_t)clk : CLOCK_MONOTONIC;
+}
+
+static const struct wp_presentation_listener presentationListener = { .clock_id = presentationClockId };
+
+static void feedbackSyncOutput(void *data, struct wp_presentation_feedback *feedback, struct wl_output *output) {
+}
+
+static void feedbackAnswered(int presented, uint64_t flipNs, uint32_t refresh, uint64_t seq) {
+    pthread_mutex_lock(&wsClock.lock);
+    if (wsClock.pending > 0 && --wsClock.pending == 0)
+        wsClock.pendingSince = 0;
+    if (presented) {
+        struct timespec t;
+        uint64_t hostNow = mach_absolute_time(), nowNs = 0;
+        if (clock_gettime(ws.presentationClock, &t) == 0)
+            nowNs = (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+        // the flip's time on our host clock: now, less how long ago the flip was on the compositor's clock
+        uint64_t ago = nowNs > flipNs ? nowNs - flipNs : 0;
+        uint64_t host = hostNow - wsNsToHost(ago);
+        if (seq != wsClock.flipSeq || host > wsClock.presentedHost + wsNsToHost(2000000)) {
+            wsClock.flipSeq = seq;
+            wsClock.presentedHost = host;
+            wsClock.counter++;
+        }
+        if (refresh >= 4000000 && refresh <= 50000000)
+            wsClock.refreshNs = refresh;
+    }
+    pthread_cond_broadcast(&wsClock.moved);
+    pthread_mutex_unlock(&wsClock.lock);
+}
+
+static void feedbackPresented(void *data, struct wp_presentation_feedback *feedback, uint32_t secHi, uint32_t secLo,
+                              uint32_t nsec, uint32_t refresh, uint32_t seqHi, uint32_t seqLo, uint32_t flags) {
+    uint64_t flipNs = (((uint64_t)secHi << 32) | secLo) * 1000000000ull + nsec;
+    if (getenv("PD_WS_TIMING") != NULL)
+        fprintf(stderr, "WSTIME %.1f presented flip=%llu refresh=%u flags=%x\n", wsNowMs(),
+                (unsigned long long)(((uint64_t)seqHi << 32) | seqLo), refresh, flags);
+    feedbackAnswered(1, flipNs, refresh, ((uint64_t)seqHi << 32) | seqLo);
+    wp_presentation_feedback_destroy(feedback);
+}
+
+static void feedbackDiscarded(void *data, struct wp_presentation_feedback *feedback) {
+    feedbackAnswered(0, 0, 0, 0);
+    wp_presentation_feedback_destroy(feedback);
+}
+
+static const struct wp_presentation_feedback_listener feedbackListener = {
+    .sync_output = feedbackSyncOutput,
+    .presented = feedbackPresented,
+    .discarded = feedbackDiscarded,
+};
+
+// before a commit that shows a new frame: ask for the flip that will show it
+static void windowAskPresentation(struct wsWindow *window) {
+    if (ws.presentation == NULL || window->surface == NULL)
+        return;
+    struct wp_presentation_feedback *feedback = wp_presentation_feedback(ws.presentation, window->surface);
+    if (feedback == NULL)
+        return;
+    wp_presentation_feedback_add_listener(feedback, &feedbackListener, NULL);
+    pthread_mutex_lock(&wsClock.lock);
+    if (wsClock.pending++ == 0)
+        wsClock.pendingSince = mach_absolute_time();
+    pthread_mutex_unlock(&wsClock.lock);
+}
+
+/* The display link's view of the clock: 0 while no flip has been reported (no wp_presentation, or nothing shown
+ * yet). `pending` counts commits whose flip has not been reported, `pendingSince` (host time) the oldest. */
+int _windowServerDisplayClock(uint64_t *presentedHostTime, uint64_t *refreshNs, uint64_t *counter, int *pending,
+                              uint64_t *pendingSince) {
+    pthread_mutex_lock(&wsClock.lock);
+    int known = wsClock.counter > 0;
+    if (presentedHostTime) *presentedHostTime = wsClock.presentedHost;
+    if (refreshNs) *refreshNs = wsClock.refreshNs ? wsClock.refreshNs : 16666667;
+    if (counter) *counter = wsClock.counter;
+    if (pending) *pending = wsClock.pending;
+    if (pendingSince) *pendingSince = wsClock.pendingSince;
+    pthread_mutex_unlock(&wsClock.lock);
+    return known;
+}
+
+// waits until a flip after `counter` is reported, or until the host time `deadline`; 1 when one was
+int _windowServerDisplayClockWait(uint64_t counter, uint64_t deadline) {
+    int moved;
+    pthread_mutex_lock(&wsClock.lock);
+    for (;;) {
+        moved = wsClock.counter != counter;
+        uint64_t now = mach_absolute_time();
+        if (moved || now >= deadline)
+            break;
+        uint64_t ns = wsHostToNs(deadline - now);
+        struct timespec rel = { (time_t)(ns / 1000000000ull), (long)(ns % 1000000000ull) };
+        pthread_cond_timedwait_relative_np(&wsClock.moved, &wsClock.lock, &rel);
+    }
+    pthread_mutex_unlock(&wsClock.lock);
+    return moved;
+}
