#!/bin/sh
# Guest side of the NVRAM registry check: does this kernel have anything that could write
# the machine's NVRAM? (IOSetRecoveryBoot waits for the IONVRAM resource before it writes
# boot-command.) Read-only. @SSID@/@PSK@ are unused.
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nPDNV_BEGIN\n'
printf 'PDNV_IOREG_PRESENT=%s\n' "$(command -v ioreg || echo none)"
for class in IONVRAMController IODTNVRAM IODTNVRAMPlatformNotifier AppleARMNORFlashDevice AppleEmbeddedNVRAM; do
    printf 'PDNV_CLASS %s: %s\n' "$class" "$(ioreg -r -c "$class" 2>&1 | head -3 | tr '\n' ' ' | cut -c1-200)"
done
printf 'PDNV_RESOURCES: %s\n' "$(ioreg -r -c IOResources -l 2>&1 | grep -i -E 'nvram|IONVRAM' | head -5 | tr '\n' ' ' | cut -c1-300)"
printf 'PDNV_NAMES: %s\n' "$(ioreg -l 2>&1 | grep -i -E 'nvram|nor-flash|spi-nor|/options' | head -12 | tr '\n' ' ' | cut -c1-600)"
printf 'PDNV_NVRAM_TOOL: %s\n' "$(nvram -p 2>&1 | head -3 | tr '\n' ' ' | cut -c1-200)"
printf 'PDNV_END\n'
printf '\nPD_BENCH_DONE\n'
